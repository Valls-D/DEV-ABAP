*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM hu_fill_humseg_hu.

  DATA: ls_lemovdat LIKE lemovdat,
        ls_header   TYPE vekpvb,
        ls_ekpo     TYPE ekpo,
        lf_xchar    TYPE xfeld,
        wa_xvbpa    LIKE vbpa.                              "n_1845520

  CALL FUNCTION 'V51P_OVEKP_FILL'                           "SP_563194
    EXPORTING
      if_highest_number = 'X'
      if_venum          = gt_humseg_hu-venum
      if_no_04          = 'X'
    IMPORTING
      es_highest_hu     = ls_header
    EXCEPTIONS
      vekp_not_found    = 1
      no_upper_vse      = 2
      wrong_vepo        = 3
      OTHERS            = 4.
  IF sy-subrc IS INITIAL AND
     ( xlikp-vbtyp           <> if_sd_doc_category=>delivery_shipping_notif OR
       xlikp-spe_le_scenario <> 'S'        OR
       ls_header-vpobj       <> gc_pacobj-x_ibdlvry ).
    gt_humseg_hu-exidv_ob = ls_header-exidv.
  ENDIF.
  IF sy-subrc = 2.
    ls_header-venum = gt_humseg_hu-venum.
    CALL FUNCTION 'V51P_FIND_HEADER'
      EXPORTING
        is_vekp        = ls_header
      IMPORTING
        es_header      = ls_header
      EXCEPTIONS
        not_found      = 1
        no_shp_mat     = 2
        error_on_exidv = 3
        fatal_error    = 4
        OTHERS         = 5.
    IF sy-subrc IS INITIAL.
      gt_humseg_hu-exidv_ob = ls_header-exidv.
    ENDIF.
  ENDIF.


  IF xlips-shkzg CA ' X'.          "<<< note 364189
    CALL FUNCTION 'LE_MOVEMENT_DATA_DETERMINE_TAB'
      EXPORTING
        if_select_t156  = charx
        is_lips         = xlips
      IMPORTING
        es_lemovdat     = ls_lemovdat
      EXCEPTIONS
        no_entry_t001w  = 1
        no_entry_t001l  = 2
        no_entry_t134m  = 3
        no_entry_t156   = 4
        no_entry_t156s  = 5
        no_entry_t156sc = 6
        no_entry_t156n  = 7
        no_entry_t156q  = 8
        no_entry_t159l  = 9
        no_entry_mara   = 10
        OTHERS          = 11.
    IF sy-subrc <> 0.

    ELSE.
      MOVE ls_lemovdat-shkzg TO xlips-shkzg.
    ENDIF.
  ENDIF.

* Determine field LEIT
  CASE xlips-shkzg.
    WHEN chars.
      gt_humseg_hu-leit = char_plus.
    WHEN charh.
      gt_humseg_hu-leit = char-.
  ENDCASE.

* Begin of note 1373167
* An adjustment of the determined value might be necessary for
* one step transfers to dec. WM using movement type 311/301
  IF gt_humseg_hu-leit = char-  AND
     xlikp-vbtyp = if_sd_doc_category=>delivery_shipping_notif   AND         "like inbound delivery
     xlikp-kzwab = 'D'          AND         "movement is on dec. system
     xlips-posting_change = 'C' AND
     xlips-shkzg_um IS INITIAL  AND
     xlips-kzuml IS INITIAL.

    gt_humseg_hu-leit = char_plus.
  ENDIF.
* End of note 1373167

* Fill fields for normal and transfer positings

  CASE xlips-shkzg_um.
    WHEN char1.
      gt_humseg_hu-matnr      = xlips-matnr.
      gt_humseg_hu-werks      = xlips-werks.
      gt_humseg_hu-lgort      = xlips-lgort.
      gt_humseg_hu-bestq      = xlips-bestq.
      gt_humseg_hu-sonum      = xlips-sonum.
      gt_humseg_hu-sobkz      = xlips-sobkz.
      IF xlips-xchar = charx AND                            "v_n_508396
         xlips-xchpf IS INITIAL AND
         xlips-bwtex = charx.
        gt_humseg_hu-charg      = xlips-bwtar.
      ELSE.
        gt_humseg_hu-charg      = xlips-charg.
      ENDIF.                                                "^_n_508396
      IF cl_ops_switch_check=>sfsw_segmentation( ) EQ abap_on and ( gt_humseg_hu-sgt_scat is initial ).     "3255772
            gt_humseg_hu-sgt_scat = xlips-sgt_scat.
      ENDIF.

      IF NOT xlips-kzuml IS INITIAL
* For CC-postings KZUML is filled though HUs are posted GI
         AND NOT xlips-posting_change = 'D'                 "SP_517871
         AND NOT xlips-posting_change = 'E'.
        gt_humseg_hu-n_matnr    = xlips-ummat.
        gt_humseg_hu-n_werks    = xlips-umwrk.
        gt_humseg_hu-n_lgort    = xlips-umlgo.
        gt_humseg_hu-n_sobkz    = xlips-umsok.
        gt_humseg_hu-n_bestq    = xlips-umbsq.
        gt_humseg_hu-n_sonum    = xlips-usonu.
        IF NOT xlips-fobwa IS INITIAL.                      "HP_435904
          IF gt_humseg_hu-leit = '+'.
            gt_humseg_hu-gegen = '-'.
          ELSE.
            gt_humseg_hu-gegen = '+'.
          ENDIF.
        ENDIF.
        IF xlips-xchar = charx AND                          "v_n_508396
           xlips-xchpf IS INITIAL AND
           xlips-bwtex = charx.
          gt_humseg_hu-n_charg    = xlips-umbar.
        ELSE.
          gt_humseg_hu-n_charg    = xlips-umcha.
        ENDIF.                                              "^_n_508396
        IF NOT gt_humseg_hu-charg IS INITIAL AND           "v_n_1699862
               gt_humseg_hu-n_charg IS INITIAL.
*.......check, if the material is also batch-managed in the destination
*.......plant. If yes, take the source charg.
          PERFORM batch_managed USING gt_humseg_hu-matnr
                                      gt_humseg_hu-n_werks
                             CHANGING lf_xchar.
          IF NOT lf_xchar IS INITIAL.
            gt_humseg_hu-n_charg = gt_humseg_hu-charg.
          ENDIF.
        ENDIF.                                             "^_n_1699862
      ENDIF.
      IF cl_ops_switch_check=>sfsw_segmentation( ) EQ abap_on and ( gt_humseg_hu-charg eq gt_humseg_hu-n_charg ). "3239161
            gt_humseg_hu-sgt_umscat = gt_humseg_hu-sgt_scat.
      ENDIF.
      CASE xlips-posting_change.                            "HP_435904
        WHEN 'A'.
          gt_humseg_hu-g_transit = 'X'.
        WHEN 'B'.
          IF gt_humseg_hu-leit = '+'.
            gt_humseg_hu-l_transit = 'X'.
          ELSE.
            gt_humseg_hu-g_transit = 'X'.
          ENDIF.
      ENDCASE.
    WHEN char2.
      gt_humseg_hu-matnr      = xlips-ummat.
      gt_humseg_hu-werks      = xlips-umwrk.
      gt_humseg_hu-lgort      = xlips-umlgo.
      gt_humseg_hu-bestq      = xlips-umbsq.
      gt_humseg_hu-sobkz      = xlips-umsok.
      gt_humseg_hu-sonum      = xlips-usonu.
      IF xlips-xchar = charx AND                            "v_n_508396
         xlips-xchpf IS INITIAL AND
         xlips-bwtex = charx.
        gt_humseg_hu-charg      = xlips-umbar.
      ELSE.
        gt_humseg_hu-charg      = xlips-umcha.
      ENDIF.                                                "^_n_508396
      IF NOT xlips-kzuml IS INITIAL
         AND NOT xlips-posting_change = 'D'                 "SP_528859
         AND NOT xlips-posting_change = 'E'.
        gt_humseg_hu-n_matnr    = xlips-matnr.
        gt_humseg_hu-n_werks    = xlips-werks.
        gt_humseg_hu-n_lgort    = xlips-lgort.
        gt_humseg_hu-n_bestq    = xlips-bestq.
        gt_humseg_hu-n_sobkz    = xlips-sobkz.
        gt_humseg_hu-n_sonum    = xlips-sonum.
        IF NOT xlips-fobwa IS INITIAL.                      "HP_435904
          IF gt_humseg_hu-leit = '+'.
            gt_humseg_hu-gegen = '-'.
          ELSE.
            gt_humseg_hu-gegen = '+'.
          ENDIF.
        ENDIF.
        IF xlips-xchar = charx AND                          "v_n_508396
           xlips-xchpf IS INITIAL AND
           xlips-bwtex = charx.
          gt_humseg_hu-n_charg    = xlips-bwtar.
        ELSE.
          gt_humseg_hu-n_charg    = xlips-charg.
        ENDIF.                                              "^_n_508396
      ENDIF.
      CASE xlips-posting_change.                            "HP_435904
        WHEN 'A'.
          gt_humseg_hu-g_transit = 'X'.
        WHEN 'B'.
          IF gt_humseg_hu-leit = '+'.
            gt_humseg_hu-l_transit = 'X'.
          ELSE.
            gt_humseg_hu-g_transit = 'X'.
          ENDIF.
      ENDCASE.
    WHEN OTHERS.
      MOVE-CORRESPONDING xlips TO gt_humseg_hu.
      IF xlips-xchar = charx AND                            "v_n_508396
         xlips-xchpf IS INITIAL AND
         xlips-bwtex = charx.
        gt_humseg_hu-charg    = xlips-bwtar.
      ENDIF.                                                "^_n_508396
      IF cl_sd_doc_category_util=>is_delivery_outgoing( iv_vbtyp = xlikp-vbtyp ) "n_1551643
         AND tvlk-aufer = 'B'    "(Umlagerbestellung)
         AND NOT xlips-posting_change = 'D'                 "SP_528859
         AND NOT xlips-posting_change = 'E'.
        gt_humseg_hu-n_matnr = xlips-matnr.
        IF xlips-xchar = charx AND
           xlips-xchpf IS INITIAL AND
           xlips-bwtex = charx.
          gt_humseg_hu-n_charg = xlips-umbar.
        ELSE.
          gt_humseg_hu-n_charg = xlips-umcha.
        ENDIF.
        gt_humseg_hu-n_werks = xlikp-werks.
        IF NOT gt_humseg_hu-charg IS INITIAL AND            "SP_638754
               gt_humseg_hu-n_charg IS INITIAL.
*.......check, if the material is also batch-managed in the destination
*.......plant. If yes, take the source charg.
          PERFORM batch_managed USING gt_humseg_hu-matnr
                                      xlikp-werks
                             CHANGING lf_xchar.
          IF NOT lf_xchar IS INITIAL.
            gt_humseg_hu-n_charg = gt_humseg_hu-charg.
          ENDIF.
        ENDIF.
        IF cl_ops_switch_check=>sfsw_segmentation( ) EQ abap_on and ( gt_humseg_hu-charg eq gt_humseg_hu-n_charg ). "3239161
            gt_humseg_hu-sgt_umscat = gt_humseg_hu-sgt_scat.
        ENDIF.
*.......In the case of purchase orders the destination field umlgo
*.......and umwrk are not filled in lips.
        IF xlips-posting_change CA 'CF'.                    "SP_580367
          CLEAR ls_ekpo.
          PERFORM hu_get_ekpo USING xlips-vgbel xlips-vgpos
                              CHANGING ls_ekpo.
          IF NOT ls_ekpo-lgort IS INITIAL.
            gt_humseg_hu-n_lgort = ls_ekpo-lgort.
          ENDIF.
        ENDIF.
        gt_humseg_hu-n_bestq = xlips-bestq.
        gt_humseg_hu-n_sobkz = xlips-sobkz.
        gt_humseg_hu-n_sonum = xlips-sonum.
        IF gt_humseg_hu-leit = '+'.                         "HP_435904
          gt_humseg_hu-gegen = '-'.
        ELSE.
          gt_humseg_hu-gegen = '+'.
        ENDIF.
        CASE xlips-posting_change.                          "HP_435904
          WHEN 'A'.
            gt_humseg_hu-g_transit = 'X'.
          WHEN 'B'.
            IF gt_humseg_hu-leit = '+'.
              gt_humseg_hu-l_transit = 'X'.
            ELSE.
              gt_humseg_hu-g_transit = 'X'.
            ENDIF.
        ENDCASE.
      ENDIF.
*.....Transfer to consi. In this case the only hint that     SP_565685
*.....it is a transfer and no GI ist posting_change = C
      IF xlips-kzuml IS INITIAL AND xlips-posting_change = 'C'
         AND cl_sd_doc_category_util=>is_delivery_outgoing( iv_vbtyp = xlikp-vbtyp ) AND tvlk-aufer CA 'LX'. "n_694544
        IF xlikp-vbtyp = if_sd_doc_category=>delivery.      "SP_584157
          gt_humseg_hu-gegen = '+'.
* note 2145516 - 10 lines moved
          IF tvlk-aufer = 'L'.              " Subcontracting
            gt_humseg_hu-n_sobkz = 'O'.
* Subcontracting - Vendor number to be stored in destination item
            gt_humseg_hu-n_sonum = xlikp-lifnr.             "n_2145516
          ELSE.                             " Consignment
            gt_humseg_hu-n_sobkz = 'W'.
* Consignment Customer number to be stored in destination item (or special stock partner)
* If Special Stock Partner exists, HU must be updated.......n_v_1845520/2145516
            CLEAR wa_xvbpa.
            READ TABLE xvbpa WITH KEY
                    vbeln = xlikp-vbeln posnr = '000000' parvw = 'SB'
                            INTO wa_xvbpa.
            IF NOT wa_xvbpa-kunnr IS INITIAL.
              gt_humseg_hu-n_sonum = wa_xvbpa-kunnr.
            ELSE.                                            "n_^_1845520
              gt_humseg_hu-n_sonum = xlikp-kunnr.           "n_v_853846
            ENDIF.
          ENDIF.                                            "n_^_853846

          "{ Begin ENHO ADSUB_FV50WF0H IS-AD-SUC AD_SUB }
**- Transfer right special stock for A&D Subcontracting        v-1960204
**- relevant items
          DATA: ls_adrelev  TYPE adsub_d_isads,
                ls_ad_ebeln TYPE ebeln,
                ls_ad_ebelp TYPE ebelp.

          IF xlips-vgbel IS NOT INITIAL AND
             xlips-vgpos IS NOT INITIAL AND
             tvlk-aufer  EQ 'L'.
*- Check PO's A&D Subcontracting relevancy
            CLEAR: ls_adrelev, ls_ad_ebeln, ls_ad_ebelp.
            MOVE: xlips-vgbel TO ls_ad_ebeln,
                  xlips-vgpos TO ls_ad_ebelp.
            CALL FUNCTION 'ADSUB_CHECK_PO'
              EXPORTING
                iv_ebeln       = ls_ad_ebeln
                iv_ebelp       = ls_ad_ebelp
              IMPORTING
                ev_adrelev     = ls_adrelev
              EXCEPTIONS
                ex_no_po_found = 1
                OTHERS         = 2.
*- Reference PO is A&D relevant
            IF sy-subrc EQ 0.
              IF ls_adrelev IS NOT INITIAL.
*- Copy next special stock indicator instead of static 'O'
                CALL FUNCTION 'DISUB_GET_SPECIAL_STOCK_IND_SC'
                  EXPORTING
                    im_sobkz                = gt_humseg_hu-sobkz
                  IMPORTING
                    ex_sobkz                = gt_humseg_hu-n_sobkz
                  EXCEPTIONS
                    no_special_stock_for_sc = 1
                    OTHERS                  = 2.
*- Copy next special stock identifier
                gt_humseg_hu-n_sonum = gt_humseg_hu-sonum.
              ENDIF.          "PO A&D subcon relevant
            ENDIF.            "PO A&D Subcon check call
          ENDIF.              "PO and PO item filled           ^-1960204
*          "{ End ENHO ADSUB_FV50WF0H IS-AD-SUC AD_SUB }

ENHANCEMENT-POINT adsub_hu_fill_humseg_hu_01 SPOTS es_sapfv50w .

        ELSE.
          gt_humseg_hu-gegen = '-'.
          gt_humseg_hu-n_sobkz = gt_humseg_hu-sobkz.        "n_853846
          gt_humseg_hu-n_sonum = gt_humseg_hu-sonum.        "n_853846
        ENDIF.
        gt_humseg_hu-n_werks = gt_humseg_hu-werks.
        gt_humseg_hu-n_matnr = gt_humseg_hu-matnr.
        gt_humseg_hu-n_charg = gt_humseg_hu-charg.
*        gt_humseg_hu-n_sobkz = gt_humseg_hu-sobkz.             n_853846
*        gt_humseg_hu-n_sonum = gt_humseg_hu-sonum.             n_853846
        gt_humseg_hu-n_bestq = gt_humseg_hu-bestq.
      ENDIF.
      IF xlikp-vbtyp = if_sd_doc_category=>delivery_shipping_notif                                 "note 628989
*         and xlips-posting_change is initial "              "SP_681416
         AND tvlk-aufer = 'B'.
*         and xlips-kzuml is initial.                        "SP_681416
        CASE xlips-insmk.
          WHEN 'X' OR '2'.
            gt_humseg_hu-bestq = 'Q'.
          WHEN 'S' OR '3'.
            gt_humseg_hu-bestq = 'S'.
        ENDCASE.
        IF xlikp-mdiff_buch IS NOT INITIAL.                "v_n_1098150
          CASE xlips-spe_mdiff_insmk.
            WHEN 'X' OR '2'.
              gt_humseg_hu-bestq = 'Q'.
            WHEN 'S' OR '3'.
              gt_humseg_hu-bestq = 'S'.
            WHEN 'F'.
              gt_humseg_hu-bestq = ' '.
          ENDCASE.
        ENDIF.                                             "^_n_1098150
      ENDIF.
  ENDCASE.
* Special case: Return to vendor with handling units         "v_n_564521
*                   (movement types 122 and 161)
  IF likp-vbtyp EQ if_sd_doc_category=>delivery   AND
     xlips-kzbew CA 'BF'    AND NOT
     xlips-vgbel IS INITIAL AND NOT
     xlips-vgpos IS INITIAL AND
     xlips-vgtyp EQ if_sd_doc_category=>purchase_order   AND
     tvlk-aufer CA 'BR'.
*... Check that the Advanced Returns Management Functionality is active  "v_n_1386748
    IF cl_ops_switch_check=>ops_sfws_sc_advret1( ) IS NOT INITIAL AND
       likp-msr_active = charx.
      IF xlips-posting_change NA 'BE'.
        CLEAR: gt_humseg_hu-gegen  ,
               gt_humseg_hu-n_matnr,
               gt_humseg_hu-n_charg,
               gt_humseg_hu-n_werks,
               gt_humseg_hu-n_lgort,
               gt_humseg_hu-n_bestq,
               gt_humseg_hu-n_sobkz,
               gt_humseg_hu-n_sonum,
               gt_humseg_hu-n_lgnum,
               gt_humseg_hu-n_lgtyp,
               gt_humseg_hu-n_lgpla.
      ENDIF.
*... non ARM Process
    ELSE.                                                               "^_n_1386748
      IF xlips-posting_change NA 'BE'.                      "n_1990319
        CLEAR: gt_humseg_hu-gegen  ,
             gt_humseg_hu-n_matnr,
             gt_humseg_hu-n_charg,
             gt_humseg_hu-n_werks,
             gt_humseg_hu-n_lgort,
             gt_humseg_hu-n_bestq,
             gt_humseg_hu-n_sobkz,
             gt_humseg_hu-n_sonum,
             gt_humseg_hu-n_lgnum,
             gt_humseg_hu-n_lgtyp,
             gt_humseg_hu-n_lgpla.
      ENDIF.                                                "n_1990319
    ENDIF.                                                  "n_1386748
  ENDIF.                                                    "^_n_564521
  CLEAR gt_humseg_hu-qplos.
ENDFORM.                               " HU_FILL_HUMSEG_HU
