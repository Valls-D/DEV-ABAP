*                                                                     *
***********************************************************************
*&---------------------------------------------------------------------*
*&      Form  HU_GET_TABLES
*&---------------------------------------------------------------------*
*       Fetch tables VEPO and VEKP
*----------------------------------------------------------------------*
FORM hu_get_tables.
  DATA: lf_no_db_select TYPE xfeld.                         "HP 215458
  DATA: ls_object   TYPE vsep_s_objkey.
  DATA: lf_unique TYPE xfeld.
  DATA: lf_process TYPE /spe/gen_process.                   "n_1537900
  DATA: lf_more_hus TYPE xfeld.                             "HP_435519
  DATA: ls_packing TYPE vse_s_v51h,                         "SP_549474
        ls_likp    TYPE likpvb.

*...XAN HU_lean_status_update for non-unique HU numbering setting
  DATA: lf_spe_lean_hustat TYPE tvshp-spe_lean_hustat.

*... has there been packed anything before ?
  CHECK NOT xvbuk-pkstk CA ' A'.
  CHECK NOT v50agl-huactive IS INITIAL OR                     "HUM
        NOT v50agl-spe_auto_gr IS INITIAL.  "SPM Auto GR

  CALL FUNCTION 'HU_TVSHP_SELECT'
    IMPORTING
      ef_exidv_unique    = lf_unique                      "v_XAN-SPM
      ef_spe_lean_hustat = lf_spe_lean_hustat.

*...XAN HU_lean_status_update for non-unique HU numbering setting
  IF NOT lf_spe_lean_hustat IS INITIAL.
  ELSE.                                                       "^_XAN-SPM
    CHECK NOT lf_unique IS INITIAL.
  ENDIF.                                                        "XAN-SPM

*... set object for inbound or outbound delivery and returns    "XAN-SPM
  IF likp-vbtyp EQ if_sd_doc_category=>delivery.
    ls_object-object = gc_pacobj-obdlvry.
  ENDIF.
  IF cl_sd_doc_category_util=>is_delivery_incoming( iv_vbtyp = likp-vbtyp ) OR likp-vbtyp EQ if_sd_doc_category=>returns_delivery_for_order.
    ls_object-object = gc_pacobj-ibdlvry.
  ENDIF.

* SPM XAN - PARTIAL GOODS RECEIPT AND OTHERS                  "v_XAN-SPM
  IF /spe/cl_ctrl=>is_ewm( i_lgnum = likp-lgnum ) IS INITIAL. "v_n_1732632
    IF likp-vbtyp = if_sd_doc_category=>delivery_shipping_notif AND likpd-mdiff_buch = 'X'
    AND likpd-mdiff_storno = 'X'.
      ls_object-object = '12'.
    ENDIF.
  ENDIF.                                                      "^_n_1732632

* SPM XAN - PARTIAL GOODS RECEIPT AND OTHERS
  IF likp-vbtyp = if_sd_doc_category=>returns_delivery_for_order AND likpd-mdiff_buch = 'X'
   AND likpd-mdiff_storno = 'X'.
    CALL FUNCTION '/SPE/RET_HU_DATA_GET'                    "v_n_1537900
      IMPORTING
        ef_process_indicator = lf_process.
    IF lf_process NE 'QDP'.
      ls_object-object = '12'.
    ELSE.                                                   "n_2190750
      EXIT.                                                 "n_2190750
    ENDIF.                                                  "^_n_1537900
  ENDIF.                                                    "^_XAN-SPM

  ls_object-objkey = likp-vbeln.
  IF likpd-updkz = 'I'.
    lf_no_db_select = charx.
  ELSE.
    CLEAR lf_no_db_select.
  ENDIF.
*... now we fetch tables VEPO and VEKP
*... bei Umbuchung kann es sein, daß nur ein Teil der HU an der LF hängt
  IF tvlk-aufer = 'H'.                                      "HP_435519
    lf_more_hus = 'X'.                                      "HP_435519
  ENDIF.                                                    "HP_435519


*... because of errors that occured only when posting was performed
*....directly without displaying the packing screen before, packing
*....is now called always.
  IF cl_sd_doc_category_util=>is_delivery_incoming( iv_vbtyp = likp-vbtyp ) OR likp-vbtyp EQ if_sd_doc_category=>returns_delivery_for_order. "SP_549474
    ls_packing-object = '03'.
  ELSE.
    ls_packing-object = '01'.
  ENDIF.

* MDIFF / INBOUND                                             "v_XAN-SPM
  IF /spe/cl_ctrl=>is_ewm( i_lgnum = likp-lgnum ) IS INITIAL. "v_n_1732632
    IF likp-vbtyp = if_sd_doc_category=>delivery_shipping_notif AND likpd-mdiff_buch = 'X'
    AND likpd-mdiff_storno = 'X'.
      ls_packing-object = '12'.
    ENDIF.
  ENDIF.                                                      "^_n_1732632

* MDIFF / RETURNS
  IF likp-vbtyp = if_sd_doc_category=>returns_delivery_for_order AND likpd-mdiff_buch = 'X'
  AND likpd-mdiff_storno = 'X' AND lf_process NE 'QDP'.     "n_1537900
    ls_packing-object = '12'.
  ENDIF.                                                      "^_XAN-SPM

  ls_likp = likp.
  ls_packing-display = t180-trtyp.
  ls_packing-init = 'X'.
  ls_packing-conf_dec = v50agl-confirm_central.
  ls_packing-tvlk_aufer = tvlk-aufer.
  ls_packing-tvlk_pmpos_gen = tvlk-pm_item_gen.
  CALL FUNCTION 'HU_PACKING_DELIVERY'
    EXPORTING
      is_delivery = ls_packing
      is_likp     = ls_likp
      it_xlips    = xlips[]
      it_xvbuk    = xvbuk[]
      it_xvbup    = xvbup[]
      it_xvbpa    = xvbpa[]
    CHANGING
      ct_xvbfa    = xpackvbfa[]
      ct_yvbfa    = ypackvbfa[]
      ct_xvbapf   = xvbapf[].

  CALL FUNCTION 'HU_GET_HUS'
    EXPORTING
      if_object       = ls_object-object
      if_no_db_select = lf_no_db_select
      if_more_hus     = lf_more_hus                         "HP_435519
      is_objects      = ls_object
      if_lock_hus     = charx
    IMPORTING
      et_header       = gt_vekp
      et_items        = gt_vepo
    EXCEPTIONS
      OTHERS          = 0.

  IF sy-subrc <> 0.
* MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
*         WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.
ENDFORM.                               " HU_GET_TABLES


*&---------------------------------------------------------------------*
*&      Form  HU_CREATE_LIVE
*&---------------------------------------------------------------------*
*       Create link between LIPS and VEPO and move it into table GT_LIVE
*----------------------------------------------------------------------*
FORM hu_create_live USING if_error_flag.

  DATA: lf_idxfr    TYPE sy-tabix,
        lf_idxfr_lt TYPE sy-tabix.
  DATA: lf_idxto LIKE sy-tfill.
* Don't create GT_LIVE
  DATA: lf_no_cr_live TYPE xfeld.                           "RG 895404
  DATA: lf_unique TYPE xfeld.                               "HP_355955
* Teil-WE
  DATA: lt_objects  TYPE lepgr_objects,
        ls_objects  LIKE LINE OF lt_objects,
        ls_header51 TYPE header51,                          "n_1791800
        ls_vekp     LIKE LINE OF gt_vekp.
  DATA: lt_vepo  TYPE vsep_t_vepo,                          "n_v_809671
        lt_venum TYPE hum_venum_t,
        ls_venum TYPE venum,
        ls_vepo  LIKE vepovb.                               "n_^_809671
  FIELD-SYMBOLS:   <ls_objects> LIKE LINE OF lt_objects.

  DATA: lt_qchg TYPE /spe/inb_obj_quan_chg_t,               "v_XAN-SPM
        ls_qchg LIKE LINE OF lt_qchg.                       "^_XAN-SPM

  FIELD-SYMBOLS:  <ls_qchg> LIKE LINE OF lt_qchg.               "XAN-SPM

*...XAN HU_lean_status_update for non-unique HU numbering setting
  DATA: lf_spe_lean_hustat TYPE tvshp-spe_lean_hustat.

*... has there been packed anything before ?
  CHECK NOT xvbuk-pkstk CA ' A'.

*... No HU update for TPOP
  IF xlikp-spe_le_scenario = gc_le_scenario-tpop.           "v_n_1791800
* Publish TPOP-scenario in order to deactive certain HU consistency checks
* in FM HU_CONSISTENZ_CHECK
    CALL FUNCTION 'V51P_GET_HEADER_DATA'
      IMPORTING
        es_header51 = ls_header51.
    ls_header51-le_scenario = gc_le_scenario-tpop.
    CALL FUNCTION 'V51P_FILL_GT'
      EXPORTING
        is_header51 = ls_header51
      EXCEPTIONS
        hu_locked   = 1
        no_hu_found = 2
        fatal_error = 3
        OTHERS      = 4.
  ENDIF.                                                    "^_n_1791800
  CHECK xlikp-spe_le_scenario NE gc_le_scenario-tpop.       "n_1743643

* check if HUM is active                                    "n_1088020
  CALL FUNCTION 'HU_TVSHP_SELECT'
    IMPORTING
      ef_exidv_unique    = lf_unique                      "v_XAN-SPM
      ef_spe_lean_hustat = lf_spe_lean_hustat.

*...XAN HU_lean_status_update for non-unique HU numbering setting
  IF NOT lf_spe_lean_hustat IS INITIAL.
  ELSE.                                                       "^_XAN-SPM
    CHECK NOT lf_unique IS INITIAL.
  ENDIF.                                                        "XAN-SPM

  CALL FUNCTION 'LE_GET_PGR_OBJECTS'
    EXPORTING
      i_objtyp    = '01'  "Nur HUs holen
    IMPORTING                                                 "v_XAN-SPM
      et_quan_chg = lt_qchg[]                                 "^_XAN-SPM
    TABLES
      et_objects  = lt_objects.

* maybe should be changed like the following deactivated code     "v_XAN
**   C5024641 25.09.2002 Teil-WE Ext. von Daniela
*    SORT GT_VEPO BY VBELN POSNR.
*    SORT GT_VEKP BY VENUM.                                       "^_XAN

* IF lt_objects[] IS INITIAL.                                 "v_XAN-SPM
  IF   lt_objects[] IS INITIAL OR                           "n_1246404
     ( NOT v50agl-confirm_central IS INITIAL AND
       xlikp-mdiff_buch <> 'X' ).                            "^_XAN-SPM Space and N

    DESCRIBE TABLE gt_vepo LINES lf_idxto.
    CHECK lf_idxto GT 0.
    SORT gt_vepo BY vbeln posnr.
    LOOP AT xlips WHERE NOT updkz EQ chard.
      CHECK NOT xlips-pckpf = 'B'.                          "HP_320729
      IF NOT likpd-kzebu IS INITIAL.                        "v_n_702287
        CHECK xlips-ebumg > 0.
      ENDIF.                                                "^_n_702287
      gt_live-vbeln = xlips-vbeln.
      gt_live-posnr = xlips-posnr.

      READ TABLE gt_vepo WITH KEY vbeln = xlips-vbeln
                                  posnr = xlips-posnr
                                                    INTO gs_vepo
                                                    BINARY SEARCH.
      CHECK sy-subrc EQ 0.
      lf_idxfr = sy-tabix.
* Exclude Cross-delivery HU's from Goods Issue !
      READ TABLE gt_vekp INTO gs_vekp
                         WITH KEY venum = gs_vepo-venum
                         BINARY SEARCH.
      IF sy-subrc = 0                         AND
         gs_vekp-vpobj <> gc_pacobj-x_obdlvry AND
         gs_vekp-vpobj <> gc_pacobj-x_ibdlvry.
        gt_live-venum = gs_vepo-venum.
        gt_live-vepos = gs_vepo-vepos.
        gt_live-vemng = gs_vepo-vemng.
        gt_live-vemeh = gs_vepo-vemeh.
        gt_live-sobkz = gs_vepo-sobkz.
        gt_live-sonum = gs_vepo-sonum.
        APPEND gt_live.
      ENDIF.

      lf_idxfr = lf_idxfr + 1.
      LOOP AT gt_vepo FROM lf_idxfr TO lf_idxto INTO gs_vepo.
        IF gs_vepo-vbeln <> xlips-vbeln OR
           gs_vepo-posnr <> xlips-posnr.
          EXIT.
        ENDIF.
* Exclude Cross-delivery HU's from Goods Issue !
        READ TABLE gt_vekp INTO gs_vekp
                           WITH KEY venum = gs_vepo-venum
                           BINARY SEARCH.
        IF sy-subrc = 0                         AND
           gs_vekp-vpobj <> gc_pacobj-x_obdlvry AND
           gs_vekp-vpobj <> gc_pacobj-x_ibdlvry.
          gt_live-venum = gs_vepo-venum.
          gt_live-vepos = gs_vepo-vepos.
          gt_live-vemng = gs_vepo-vemng.
          gt_live-vemeh = gs_vepo-vemeh.
          gt_live-sobkz = gs_vepo-sobkz.
          gt_live-sonum = gs_vepo-sonum.
          APPEND gt_live.
        ENDIF.

      ENDLOOP.
    ENDLOOP.
    SORT gt_live BY vbeln posnr venum vepos.                "n_991579
  ELSE.
*...Partial GR with HU ............................................*
*... Lines deleted                                             "n_809671
    LOOP AT lt_objects ASSIGNING <ls_objects> WHERE objtyp = '01'.
      READ TABLE gt_vekp INTO ls_vekp
                         WITH KEY venum = <ls_objects>-objkey.

* maybe should be changed like the following deactivated code     "v_XAN
**                       WITH KEY VENUM = <LS_OBJECTS>-OBJKEY.
*   C5024641 25.09.2002 Teil-WE Ext. von Daniela
*                        WITH KEY VENUM = <LS_OBJECTS>-OBJKEY
*                        binary search.                           "^_XAN

      IF sy-subrc EQ char0 AND ls_vekp-hu_locked NE charx.
*       MESSAGE E205(VLA) WITH ls_vekp-venum.
*       Die Teil-WE zu buchende HU muss gesperrt werden
        MOVE-CORRESPONDING xlips TO wat.
        wat-msgno = '205'.
        wat-msgty = e.
        wat-msgid = 'VLA'.
        wat-msgv1 = ls_vekp-venum.
        wat-msgv2 = xlips-vbeln.
        wat-msgv3 = xlips-posnr.
        APPEND wat.
        if_error_flag = charx.
      ENDIF.
      ls_venum = <ls_objects>-objkey.                       "n_809671
      APPEND ls_venum TO lt_venum.
    ENDLOOP.

*   Note: 895404 RG 07.11.2005 QDIFF Don't generate the GT_LIVE
*   entries when this is a partial GR/QDIFF process but no
*   objects are give for the posting.
    CLEAR lf_no_cr_live.
    IF lt_objects[] IS INITIAL "Process without HUs
    AND xlikp-vbtyp = if_sd_doc_category=>delivery_shipping_notif "Inbound delivery
    AND xlikp-kzebu = 'X' "Partial GR way for the posing
    AND xlikp-mdiff_buch = 'X'. "Quantity difference process
      lf_no_cr_live = 'X'.
    ENDIF.

*   Note: 895404 Don't generate GT_LIVE when ...
    IF lf_no_cr_live = space.                               "895404

* Build the packing hierarchy directly from LT_OBJECTS      "n_v_1119855
* GT_VEKP and GT_VEPO that only contain delivery HUs:
      LOOP AT lt_venum INTO ls_venum.
        READ TABLE gt_vepo TRANSPORTING NO FIELDS
                           WITH KEY venum = ls_venum
                           BINARY SEARCH.
        CHECK sy-subrc IS INITIAL.
        LOOP AT gt_vepo FROM sy-tabix INTO gs_vepo WHERE velin = '3'.
          IF gs_vepo-venum NE ls_venum. EXIT. ENDIF.
          ls_vepo-venum = gs_vepo-unvel.
          APPEND ls_vepo-venum TO lt_venum.
        ENDLOOP.
      ENDLOOP.
      SORT lt_venum.                                        "n_^_1119855

      SORT gt_vepo BY vbeln posnr.
      LOOP AT xlips WHERE updkz <> gc_updfl-delete
                    AND   pckpf <> charb.
        IF NOT likpd-kzebu IS INITIAL AND                   "v_n_1066685
               xlips-hupos IS INITIAL.                      "n_1161823
*         Posting parts of HUs only allowed without HUM
          CHECK xlips-ebumg > 0.
        ENDIF.                                              "^_n_1066685
        gt_live-vbeln = xlips-vbeln.
        gt_live-posnr = xlips-posnr.

        LOOP AT gt_vepo INTO gs_vepo WHERE vbeln = xlips-vbeln AND
                                           posnr = xlips-posnr.
          READ TABLE lt_venum TRANSPORTING NO FIELDS        "n_1119855
                              WITH KEY venum = gs_vepo-venum
                              BINARY SEARCH.
          CHECK sy-subrc = char0.
*   Exclude Cross-delivery HU's from Goods Issue !
          READ TABLE gt_vekp INTO gs_vekp
                             WITH KEY venum = gs_vepo-venum
                             BINARY SEARCH.
          CHECK sy-subrc = 0
          AND   gs_vekp-vpobj <> gc_pacobj-x_obdlvry
          AND   gs_vekp-vpobj <> gc_pacobj-x_ibdlvry.

          gt_live-venum = gs_vepo-venum.
          gt_live-vepos = gs_vepo-vepos.
          gt_live-vemng = gs_vepo-vemng.
          gt_live-vemeh = gs_vepo-vemeh.
*  .SPM Quantity deviations                                     "v_XAN-SPM
          READ TABLE lt_qchg ASSIGNING <ls_qchg>
                 WITH KEY objtyp = '01'
                          objkey = gs_vekp-venum
                          vbeln  = xlips-vbeln
                          posnr  = xlips-posnr
                          BINARY SEARCH.
          IF sy-subrc = 0.
            gt_live-spe_corr_quan  =  <ls_qchg>-corr_quan.
            gt_live-spe_chg_dir    = <ls_qchg>-chg_dir.
          ENDIF.                                            "^_XAN-SPM
          APPEND gt_live.
        ENDLOOP.
      ENDLOOP.

    ENDIF.  "Note 895404

    IF gt_live[] IS INITIAL.
      lt_vepo[] = gt_vepo[].
      SORT lt_vepo BY venum unvel.
      LOOP AT lt_objects INTO ls_objects WHERE objtyp = '01'.
        READ TABLE lt_vepo WITH KEY venum = ls_objects-objkey
                           BINARY SEARCH
                           TRANSPORTING NO FIELDS.
        CHECK sy-subrc IS INITIAL.
        lf_idxfr = sy-tabix.
        LOOP AT lt_vepo INTO gs_vepo FROM lf_idxfr.
          IF gs_vepo-venum <> ls_objects-objkey.
            EXIT.
          ENDIF.
          CHECK gs_vepo-unvel IS NOT INITIAL.
          READ TABLE lt_vepo WITH KEY venum = gs_vepo-unvel
                             BINARY SEARCH
                             TRANSPORTING NO FIELDS.
          CHECK sy-subrc IS INITIAL.
          lf_idxfr_lt = sy-tabix.
* Exclude Cross-delivery HU's from Goods Issue !
          READ TABLE gt_vekp INTO gs_vekp
                             WITH KEY venum = gs_vepo-unvel
                             BINARY SEARCH.
          CHECK sy-subrc = 0
          AND   gs_vekp-vpobj <> gc_pacobj-x_obdlvry
          AND   gs_vekp-vpobj <> gc_pacobj-x_ibdlvry.
          LOOP AT lt_vepo INTO ls_vepo FROM lf_idxfr_lt.
            IF ls_vepo-venum <> gs_vepo-unvel.
              EXIT.
            ENDIF.
            gt_live-vbeln = ls_vepo-vbeln.
            gt_live-posnr = ls_vepo-posnr.
            gt_live-venum = ls_vepo-venum.
            gt_live-vepos = ls_vepo-vepos.
            gt_live-vemng = ls_vepo-vemng.
            gt_live-vemeh = ls_vepo-vemeh.
*.SPM Quantity deviations                                     "v_XAN-SPM
            READ TABLE lt_qchg ASSIGNING <ls_qchg>
                   WITH KEY objtyp = '01'
                            objkey = gs_vekp-venum
                            vbeln  = xlips-vbeln
                            posnr  = xlips-posnr
                            BINARY SEARCH.
            IF sy-subrc = 0.
              gt_live-spe_corr_quan  =  <ls_qchg>-corr_quan.
              gt_live-spe_chg_dir    = <ls_qchg>-chg_dir.
            ENDIF.                                            "^_XAN-SPM

*           gt_live-exidv_ob = gs_vekp-exidv.

            APPEND gt_live.
          ENDLOOP.
        ENDLOOP.
      ENDLOOP.
    ENDIF.
    SORT gt_live BY vbeln posnr venum vepos.                "n_991579
  ENDIF.

ENDFORM.                               " HU_CREATE_LIVE


"{ Begin ENHO AUTO_BOR_FV50WF0H IS-A-GR AM_GR }
*&---------------------------------------------------------------------*
*&      Form  GET_COMMON_TAB
*&---------------------------------------------------------------------*
* C5024641 MDIFF 26.04.2002 Eine Globale InterneTabelle zurücklesen.
* ( Vorsich! Die Tabellen Type Soll kompatible Sein ! )
* Tabellen zb: XIMSEG, XLIPS, XVBFA, XLIKP, XVBUK, XVBUP, XMSEG
*----------------------------------------------------------------------*
FORM get_common_tab
        USING i_iname TYPE char30
              et_tab  TYPE STANDARD TABLE.
  DATA:
    l_error TYPE xfeld VALUE space,
    l_iname LIKE i_iname,
    lr_itab TYPE REF TO data.

  FIELD-SYMBOLS:
    <ls_itab> TYPE any,
    <lt_itab> TYPE STANDARD TABLE,
    <ls_any>  TYPE any.

  CONCATENATE i_iname '[]' INTO l_iname.
* Kopfzeile wird referiert
  ASSIGN (i_iname) TO <ls_itab>.
  CHECK sy-subrc = 0.
* Internetabelle wird referiert
  ASSIGN (l_iname) TO <lt_itab>.
  CHECK sy-subrc = 0.
  REFRESH et_tab.
* Alle Zeile Auslesen
  LOOP AT <lt_itab> ASSIGNING <ls_itab>.
    GET REFERENCE OF <ls_itab> INTO lr_itab.
*   Pointer lr_itab in pointer <ls_any> füllen. (!Keine Feldkonversion!
    ASSIGN lr_itab->* TO <ls_any>.
    IF sy-subrc <> 0.
      l_error = 'X'. EXIT.
    ENDIF.
    APPEND <ls_any> TO et_tab.
  ENDLOOP.
  IF l_error IS INITIAL.
    CLEAR sy-subrc.
  ENDIF.
ENDFORM.
"{ End ENHO AUTO_BOR_FV50WF0H IS-A-GR AM_GR }

