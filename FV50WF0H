      memory_not_empty     = 1
      OTHERS               = 2.
  IF sy-subrc <> 0.
* MESSAGE ID SY-MSGID TYPE SY-MSGTY NUMBER SY-MSGNO
*         WITH SY-MSGV1 SY-MSGV2 SY-MSGV3 SY-MSGV4.
  ENDIF.
ENDFORM.                               " HU_SET_MEMORY
*&---------------------------------------------------------------------*
*&      Form  HU_COPY_SERNR_TO_LIPS
*&---------------------------------------------------------------------*
*       Copy objectlist for serialnumber tracking in HU scenario       *
*----------------------------------------------------------------------*
*      -->IF_XANZSN     number of serialnumbers
*----------------------------------------------------------------------*
FORM hu_copy_sernr_to_lips USING if_xanzsn.

*  CHECK NOT XLIPS-HUPOS IS INITIAL.
  CHECK NOT v50agl-huactive IS INITIAL.                     "HUM

  DATA: lf_vorgang      LIKE tj01-vrgng,                    "n_599939
        lf_ident        LIKE sy-uzeit,
        lf_tfill        LIKE sy-tfill,
        lf_allowed(1)   TYPE c,
        lf_status_error TYPE c.
  DATA: BEGIN OF lt_xmsg OCCURS 10.    " messages
          INCLUDE STRUCTURE mesg.
  DATA: END OF lt_xmsg.
  DATA: ls_rserob TYPE rserob,                              "n_492902
        ls_lips   TYPE lips.                                "n_933408

  DATA: cp_sn_condense_hus TYPE xfeld,                      "v_n_991579
        sf_hu_dummy        TYPE venum VALUE 'DUMMYDUMMY',
        lt_hus             TYPE ehumpos_t,
        ls_hus             TYPE ehumpos,
        up_count_hu_items  TYPE sytfill VALUE 0,
        up_count_dl_items  TYPE sytfill VALUE 0,
        up_dl_quantity     TYPE lgmng,
        lf_old_logic       TYPE xfeld VALUE space.          "^_n_991579

* lines from note 2439425 deleted by note 2505315             "n_2505315
* during goods movement, serial numbers attached to HUs will  "n_2505315
* always be transferred to the delivery; so no profile check  "n_2505315
* needed                                                      "n_2505315

  MOVE-CORRESPONDING xlips TO ls_lips.                      "n_933408
  PERFORM sn_status_operation_determine                     "v_n_599939
                                USING    likp-vbtyp
                                         tvlk-aufer
                                         ls_lips            "n_933408
                                         charx
                                CHANGING lf_vorgang.        "^_n_599939

  IF xlips-anzsn GT 0.
*... When number of serialnumbers is greater 0 the objectlist has
*    to be deleted - but only in HUM scenario
    READ TABLE gt_live WITH KEY vbeln = xlips-vbeln
                                posnr = xlips-posnr.
    IF sy-subrc = 0.
      ls_rserob-taser = 'SER06'.                            "v_n_492902
      ls_rserob-venum = gt_live-venum.
      ls_rserob-vepos = gt_live-vepos.
*... Suppress deleting and rehanging objectlist if HU is not serialized
      CALL FUNCTION 'GET_SERNOS_OF_DOCUMENT'
        EXPORTING
          key_data            = ls_rserob
        EXCEPTIONS
          key_parameter_error = 1
          no_supported_access = 2
          no_data_found       = 3
          OTHERS              = 4.
      CHECK sy-subrc IS INITIAL.                            "^_n_492902
      CALL FUNCTION 'DELETE_SERNR_LS'
        EXPORTING
          j_vorgang          = lf_vorgang                   "n_599939
          vbeln              = xlips-vbeln
          posnr              = xlips-posnr
        IMPORTING
          status_not_allowed = lf_status_error.
*... One or more assigned serial numbers cannot be deleted ?!
      IF NOT lf_status_error IS INITIAL.
        MESSAGE a436(vl) WITH xlips-posnr.
      ELSE.
        CLEAR lips-anzsn.
      ENDIF.
    ENDIF.
  ENDIF.

  MOVE-CORRESPONDING xlips TO ls_lips.                      "n_933408
  PERFORM sn_status_operation_determine                     "v_n_599939
                                USING    likp-vbtyp
                                         tvlk-aufer
                                         ls_lips            "n_933408
                                         space
                                CHANGING lf_vorgang.        "^_n_599939

  "{ Begin ENHO AUTO_BOR_FV50WF0H IS-A-GR AM_GR }
* Inbound delivery will always be set to PMSF                "v_n_597405
  IF likp-vbtyp EQ if_sd_doc_category=>delivery_shipping_notif OR
     likp-vbtyp EQ if_sd_doc_category=>rough_goods_receipt_is_retail AND
    "SDIMP ZJK I306463 ca vbtyp_mmli and
     tvlk-aufer EQ charb      AND NOT
     lips-vgbel IS INITIAL    AND NOT
     lips-vgpos IS INITIAL.
    lf_vorgang = 'PMSF'.
  ENDIF.
  "{ End ENHO AUTO_BOR_FV50WF0H IS-A-GR AM_GR }

ENHANCEMENT-POINT fv50wf0h_03 SPOTS es_sapfv50w.

  DESCRIBE TABLE gt_live LINES up_count_hu_items.           "v_n_991579
  DESCRIBE TABLE xlips   LINES up_count_dl_items.
  up_dl_quantity = xlips-lgmng.

*...New dummy HU logic for performance reasons makes sense for a plenty
*   of serialized HUs per delivery item. With the help of the total
*   number of HU items, the number of items per delivery and the
*   quantity of the actual delivery item it should be possible to decide
*   whether it makes sense or not to use this new logic. Depending on
*   this decision the parameter CP_SN_CONDENSE_HUS can be set or not in
*   the following user exit.

  PERFORM user_exit_condense_hus
          IN PROGRAM sapmv50a IF FOUND
                     USING    up_count_hu_items
                              up_count_dl_items
                              up_dl_quantity
                     CHANGING cp_sn_condense_hus.

  IF NOT cp_sn_condense_hus IS INITIAL.
*...New Dummy HU logic

    CLEAR ls_hus. REFRESH lt_hus.
*...Prepare HU table related to this delivery item
    LOOP AT gt_live WHERE vbeln EQ xlips-vbeln AND
                          posnr EQ xlips-posnr.
      MOVE-CORRESPONDING gt_live TO ls_hus.
      APPEND ls_hus TO lt_hus.
    ENDLOOP.

    IF NOT lt_hus IS INITIAL.
*...  From now on we work with the message handler
      CLEAR lf_ident.
      CALL FUNCTION 'MESSAGES_INITIALIZE'
        EXPORTING
          i_identification = lf_ident
        IMPORTING
          e_identification = lf_ident
        EXCEPTIONS
          OTHERS           = 0.

*...  Condense the object lists for all related HUs into one dummy HU
      CALL FUNCTION 'CONDENSE_HUS_FOR_COPY_OL'
        EXPORTING
          venum         = sf_hu_dummy
          humpos_tab    = lt_hus
        EXCEPTIONS
          no_source_hus = 1
          OTHERS        = 2.

      IF sy-subrc IS INITIAL.
*...    Add dummy HU object list to the related delivery item
        CALL FUNCTION 'SERIAL_COPY_HU_LS'
          EXPORTING
            venum                = sf_hu_dummy
            vepos                = '000000'
            lief_nr              = gt_live-vbeln
            lief_pos             = gt_live-posnr
            material             = xlips-matnr
            debitor              = likp-kunnr
            vbtyp                = likp-vbtyp
            bwart                = xlips-bwart
            j_vorgang            = lf_vorgang
            quantity             = if_xanzsn
          IMPORTING
            anzsn                = lips-anzsn
            status_not_allowed   = lf_allowed
          EXCEPTIONS
            objectlist_not_found = 1
            OTHERS               = 2.

*...    Delete internal tables to be able to reuse the dummy HU
        CALL FUNCTION 'CONDENSE_HUS_FOR_COPY_OL'
          EXPORTING
            venum                 = sf_hu_dummy
            delete_only           = charx
            humpos_tab            = lt_hus
          EXCEPTIONS
            no_source_hus         = 1
            buffer_already_filled = 2
            OTHERS                = 3.

*...    Fetch the messages table
        CALL FUNCTION 'MESSAGES_GIVE'
          TABLES
            t_mesg = lt_xmsg.

*...    Move the messages into WAT protocol in case of errors
        IF NOT lf_allowed IS INITIAL.
          LOOP AT lt_xmsg.
            MOVE-CORRESPONDING xlips TO wat.
            wat-msgno = lt_xmsg-txtnr.
            wat-msgty = e.
            wat-msgid = lt_xmsg-arbgb.
            wat-msgv1 = lt_xmsg-msgv1.
            wat-msgv2 = lt_xmsg-msgv2.
            wat-msgv3 = lt_xmsg-msgv3.
            wat-msgv4 = lt_xmsg-msgv4.
            APPEND wat.
          ENDLOOP.

*...      Initialize the messages table
          CALL FUNCTION 'MESSAGES_INITIALIZE'
            EXPORTING
              i_identification = lf_ident
            EXCEPTIONS
              OTHERS           = 0.
        ENDIF.
      ELSEIF sy-subrc = 2.
*...    New logic only in case serial numbers are untouched before GM
        lf_old_logic  = charx.
      ENDIF.
    ENDIF.
  ELSE.
*...Approved step by step logic:
    lf_old_logic  = charx.
  ENDIF.

  IF NOT lf_old_logic IS INITIAL.
* Sort all the already serialnumbers (XEQUI) assigned to the HUs (2759021)
    CALL FUNCTION 'IQSM_SORT_TABLE'
      EXPORTING
        i_sort_xequi = 'A'.

*...Call function module for copying those object lists which are
*   linked to HU-items. Copy from HU-item to delivery-item
    LOOP AT gt_live WHERE vbeln EQ xlips-vbeln AND
                          posnr EQ xlips-posnr.

*...  From now on we work with the message handler
      CLEAR lf_ident.
      CALL FUNCTION 'MESSAGES_INITIALIZE'
        EXPORTING
          i_identification = lf_ident
        IMPORTING
          e_identification = lf_ident
        EXCEPTIONS
          OTHERS           = 0.

*...  Add HU object lists step by step to the related delivery item
      CALL FUNCTION 'SERIAL_COPY_HU_LS'
        EXPORTING
          venum                = gt_live-venum
          vepos                = gt_live-vepos
          lief_nr              = gt_live-vbeln
          lief_pos             = gt_live-posnr
          material             = xlips-matnr
          debitor              = likp-kunnr
          vbtyp                = likp-vbtyp
          bwart                = xlips-bwart
          j_vorgang            = lf_vorgang
          quantity             = if_xanzsn
        IMPORTING
          anzsn                = lips-anzsn
          status_not_allowed   = lf_allowed
        EXCEPTIONS
          objectlist_not_found = 1
          OTHERS               = 2.

*...  Fetch the messages table
      CALL FUNCTION 'MESSAGES_GIVE'
        TABLES
          t_mesg = lt_xmsg.

*...  Move the messages into WAT protocol in case of errors
      IF NOT lf_allowed IS INITIAL.
        LOOP AT lt_xmsg.
          MOVE-CORRESPONDING xlips TO wat.
          wat-msgno = lt_xmsg-txtnr.
          wat-msgty = e.
          wat-msgid = lt_xmsg-arbgb.
          wat-msgv1 = lt_xmsg-msgv1.
          wat-msgv2 = lt_xmsg-msgv2.
          wat-msgv3 = lt_xmsg-msgv3.
          wat-msgv4 = lt_xmsg-msgv4.
          APPEND wat.
        ENDLOOP.

*...    Initialize the messages table
        CALL FUNCTION 'MESSAGES_INITIALIZE'
          EXPORTING
            i_identification = lf_ident
          EXCEPTIONS
            OTHERS           = 0.
      ENDIF.
    ENDLOOP.
* Sort by type A not necessary anymore in this process (2759021)
    CALL FUNCTION 'IQSM_SORT_TABLE_RESET'
      EXPORTING
        i_xequi = charx.
  ENDIF.                                                    "^_n_991579

ENDFORM.                               " HU_COPY_SERNR_TO_LIPS

*&---------------------------------------------------------------------*
*&      Form  HU_FILL_HU_IMSEG USING IF_IMSEG_TABIX.
*&---------------------------------------------------------------------*
*       Fill table HU_IMSEG in case of HU scenario without
*       stock determination
*----------------------------------------------------------------------*
*  -->  IF_IMSEG_TABIX  keeps the IMSEG-Tabix
*----------------------------------------------------------------------*
FORM hu_fill_hu_imseg USING if_imseg_tabix.

  DATA: ls_vbfa TYPE vbfa.                                  "n_1099355
  DATA: lv_sit_flag TYPE flag,                               "SIT
        lv_retpo    TYPE flag.

*... Execution only in case of HU scenario
  CHECK NOT v50agl-huactive IS INITIAL OR                     "HUM
        NOT v50agl-spe_auto_gr IS INITIAL.  "SPM Auto GR

  CHECK NOT xvbuk-pkstk CA ' A'.

  DATA: lf_idxfr LIKE sy-tabix.
  DATA: lf_idxto LIKE sy-tfill.

  DESCRIBE TABLE gt_live LINES lf_idxto.
  CHECK lf_idxto GT 0.

*... Table GT_LIVE is already sorted with fields VBELN and POSNR
  READ TABLE gt_live WITH KEY vbeln = xlips-vbeln
                              posnr = xlips-posnr.
  CHECK sy-subrc IS INITIAL.                                "HP_320729

  IF ximseg-sobkz = 'T' AND NOT
     tvlk-aufer CA 'OH' AND                                 "n_2445679
     cl_ops_switch_check=>mm_sfws_sit( ) IS NOT INITIAL.
*   SIT postings from T stock always without HUS!           "v_n_1842901
*   => VLPOD and GR for return deliveries
    RETURN.                                                 "^_n_1842901
  ENDIF.

  IF NOT xlips-hupos IS INITIAL.
    lf_idxfr = sy-tabix.
    gt_hu_imseg-venum = gt_live-venum.
    gt_hu_imseg-vepos = gt_live-vepos.
    gt_hu_imseg-tabix = if_imseg_tabix.
    APPEND gt_hu_imseg.
    lf_idxfr = lf_idxfr + 1.
    IF NOT likpd-kzebu IS INITIAL.
      LOOP AT xvbfa INTO ls_vbfa                           "v_n_1099355
                    WHERE vbelv   = xlips-vbeln   AND
                          posnv   = xlips-posnr   AND
                          vbeln   = gt_live-venum AND
                          posnn   = gt_live-vepos AND
                          ( vbtyp_v = if_sd_doc_category=>delivery_shipping_notif   OR "n_1306472
                            vbtyp_v = if_sd_doc_category=>returns_delivery_for_order ) AND
                          vbtyp_n = if_sd_doc_category=>handling_unit.
*... SPM XAN INB/RET Partial GR with HUs with dec. confirm    "v_XAN-SPM
        IF likpd-mdiff_buch = 'X'.
          ls_vbfa-wbsta = chara.
        ELSE.
          ls_vbfa-wbsta = charc.
        ENDIF.
        CALL FUNCTION 'RV_XVBFA_MAINTAIN'
          EXPORTING
            fvbfa     = ls_vbfa
            f_vorgang = charv
          TABLES
            fxvbfa    = xvbfa
            fyvbfa    = yvbfa.                             "^_n_1099355
        "^_XAN-SPM
      ENDLOOP.
    ENDIF.

    LOOP AT gt_live FROM lf_idxfr TO lf_idxto.
      IF gt_live-vbeln NE xlips-vbeln OR
         gt_live-posnr NE xlips-posnr.
        EXIT.
      ENDIF.
      gt_hu_imseg-venum = gt_live-venum.
      gt_hu_imseg-vepos = gt_live-vepos.
      gt_hu_imseg-tabix = if_imseg_tabix.
      APPEND gt_hu_imseg.
      IF NOT likpd-kzebu IS INITIAL.
        LOOP AT xvbfa INTO ls_vbfa                         "v_n_1099355
                      WHERE vbelv   = xlips-vbeln   AND
                            posnv   = xlips-posnr   AND
                            vbeln   = gt_live-venum AND
                            posnn   = gt_live-vepos AND
                            ( vbtyp_v = if_sd_doc_category=>delivery_shipping_notif  OR "n_1306472
                              vbtyp_v = if_sd_doc_category=>returns_delivery_for_order ) AND
                            vbtyp_n = if_sd_doc_category=>handling_unit.
*...SPM XAN INB/RET Partial GR with HUs with dec. confirm     "v_XAN-SPM
          IF likpd-mdiff_buch = 'X'.
            ls_vbfa-wbsta = chara.
          ELSE.
            ls_vbfa-wbsta = charc.
          ENDIF.                                            "^_XAN-SPM
          CALL FUNCTION 'RV_XVBFA_MAINTAIN'
            EXPORTING
              fvbfa     = ls_vbfa
              f_vorgang = charv
            TABLES
              fxvbfa    = xvbfa
              fyvbfa    = yvbfa.                           "^_n_1099355
        ENDLOOP.
      ENDIF.
    ENDLOOP.
  ELSE.
    CLEAR: gt_humseg_hu.                                    "SP_706607
    lf_idxfr = sy-tabix.
    gt_humseg_hu-venum       = gt_live-venum.
    gt_humseg_hu-vepos       = gt_live-vepos.

* maybe should be changed like the following deactivated code     "v_XAN
**  C5024641 25.09.2002 Teil-WE Ext. von Daniela
*   gt_humseg_hu-exidv_ob    = gt_live-exidv_ob.
    gt_humseg_hu-quantity    = gt_live-vemng.
    gt_humseg_hu-vemeh       = gt_live-vemeh.
    gt_humseg_hu-imseg_tabix = if_imseg_tabix.
*   Update Posting date only if non-WM            "v_n_1282301
    IF xlikp-lgnum IS INITIAL.
      gt_humseg_hu-wdatu     = likp-wadat_ist.
    ENDIF.                                        "^_n_1282301

*   SPM Quantity deviations in HUs                            "v_XAN-SPM
    IF gt_live-spe_chg_dir <> space.
      gt_humseg_hu-movement_type = gt_live-spe_chg_dir.
      gt_humseg_hu-quantity      = gt_live-spe_corr_quan.
    ENDIF.                                                    "^_XAN-SPM

    PERFORM hu_fill_humseg_hu.
    APPEND gt_humseg_hu.
    lf_idxfr = lf_idxfr + 1.
    IF NOT likpd-kzebu IS INITIAL.
      LOOP AT xvbfa INTO ls_vbfa                           "v_n_1099355
                    WHERE vbelv   = xlips-vbeln   AND
                          posnv   = xlips-posnr   AND
                          vbeln   = gt_live-venum AND
                          posnn   = gt_live-vepos AND
                          ( vbtyp_v = if_sd_doc_category=>delivery_shipping_notif   OR "n_1306472
                            vbtyp_v = if_sd_doc_category=>returns_delivery_for_order ) AND
                          vbtyp_n = if_sd_doc_category=>handling_unit.
*...SPM XAN INB/RET Partial GR with HUs with dec. confirm     "v_XAN-SPM
        IF likpd-mdiff_buch = 'X'.
          ls_vbfa-wbsta = chara.
        ELSE.
          ls_vbfa-wbsta = charc.
        ENDIF.                                              "^_XAN-SPM
        CALL FUNCTION 'RV_XVBFA_MAINTAIN'
          EXPORTING
            fvbfa     = ls_vbfa
            f_vorgang = charv
          TABLES
            fxvbfa    = xvbfa
            fyvbfa    = yvbfa.                             "^_n_1099355
      ENDLOOP.
    ENDIF.
    LOOP AT gt_live FROM lf_idxfr TO lf_idxto.
* maybe should be changed like the following deactivated code     "v_XAN
**  LOOP AT gt_live FROM lf_idxfr TO lf_idxto.
*   LOOP AT GT_LIVE FROM LF_IDXFR.                                "^_XAN
      IF gt_live-vbeln NE xlips-vbeln OR
         gt_live-posnr NE xlips-posnr.
        EXIT.
      ENDIF.
      gt_humseg_hu-venum       = gt_live-venum.
      gt_humseg_hu-vepos       = gt_live-vepos.
      gt_humseg_hu-quantity    = gt_live-vemng.
      gt_humseg_hu-vemeh       = gt_live-vemeh.
      gt_humseg_hu-imseg_tabix = if_imseg_tabix.
*   SPM Quantity deviations in HUs                            "v_XAN-SPM
      IF gt_live-spe_chg_dir <> space.
        gt_humseg_hu-movement_type = gt_live-spe_chg_dir.
        gt_humseg_hu-quantity      = gt_live-spe_corr_quan.
      ENDIF.                                                  "^_XAN-SPM

      PERFORM hu_fill_humseg_hu.

* maybe should be changed like the following deactivated code     "v_XAN
**     C5024641 25.09.2002 Teil-WE Ext. von Daniela
*      gt_humseg_hu-exidv_ob    = gt_live-exidv_ob.               "^_XAN

      APPEND gt_humseg_hu.
      IF NOT likpd-kzebu IS INITIAL.
        LOOP AT xvbfa INTO ls_vbfa                         "v_n_1099355
                      WHERE vbelv   = xlips-vbeln   AND
                            posnv   = xlips-posnr   AND
                            vbeln   = gt_live-venum AND
                            posnn   = gt_live-vepos AND
                            ( vbtyp_v = if_sd_doc_category=>delivery_shipping_notif   OR "n_1306472
                              vbtyp_v = if_sd_doc_category=>returns_delivery_for_order ) AND
                            vbtyp_n = if_sd_doc_category=>handling_unit.
*... SPM XAN INB/RET Partial GR with HUs with dec. confirm    "v_XAN-SPM
          IF likpd-mdiff_buch = 'X'.
            ls_vbfa-wbsta = chara.
          ELSE.
            ls_vbfa-wbsta = charc.
          ENDIF.                                              "^_XAN-SPM
          CALL FUNCTION 'RV_XVBFA_MAINTAIN'
            EXPORTING
              fvbfa     = ls_vbfa
              f_vorgang = charv
            TABLES
              fxvbfa    = xvbfa
              fyvbfa    = yvbfa.                           "^_n_1099355
        ENDLOOP.
      ENDIF.
    ENDLOOP.
  ENDIF.

ENDFORM.                               " HU_FILL_HU_IMSEG


*&---------------------------------------------------------------------*
*&      Form  HU_FILL_BEFI_HU_IMSEG
*&---------------------------------------------------------------------*
*       Fill table HU_IMSEG in case of stock determination
*----------------------------------------------------------------------*
*      -->IF_IMSEG_TABIX  keeps the IMSEG-Tabix
*      -->IF_XVBFA_SOBKZ  Special stock indicator
*      -->IF_XVBFA_SONUM  Special stock number
*----------------------------------------------------------------------*
FORM hu_fill_befi_hu_imseg USING    if_imseg_tabix
                                    if_xvbfa_sobkz
                                    if_xvbfa_sonum.

*... Execution only in case of HU scenario
  CHECK NOT v50agl-huactive IS INITIAL.                     "HUM
  CHECK NOT xvbuk-pkstk CA ' A'.

  DATA: lf_idxfr LIKE sy-tabix.
  DATA: lf_idxto LIKE sy-tfill.

  DESCRIBE TABLE gt_live LINES lf_idxto.
  CHECK lf_idxto GT 0.

*... Table GT_LIVE is already sorted with fields VBELN and POSNR
  READ TABLE gt_live WITH KEY vbeln = xlips-vbeln
                              posnr = xlips-posnr.
  CHECK sy-subrc IS INITIAL.                                "n_451653
  IF NOT xlips-hupos IS INITIAL.                            "n_451653

    lf_idxfr = sy-tabix.
*... SOBKZ and SONUM have to be identical
    IF gt_live-sobkz EQ if_xvbfa_sobkz AND
       gt_live-sonum EQ if_xvbfa_sonum.
      gt_hu_imseg-venum = gt_live-venum.
      gt_hu_imseg-vepos = gt_live-vepos.
      gt_hu_imseg-tabix = if_imseg_tabix.
      APPEND gt_hu_imseg.
    ENDIF.

    lf_idxfr = lf_idxfr + 1.
    LOOP AT gt_live FROM lf_idxfr TO lf_idxto.
      IF gt_live-vbeln NE xlips-vbeln OR
         gt_live-posnr NE xlips-posnr.
        EXIT.
      ENDIF.
*... SOBKZ and SONUM have to be identical
      IF gt_live-sobkz EQ if_xvbfa_sobkz AND
         gt_live-sonum EQ if_xvbfa_sonum.
        gt_hu_imseg-venum = gt_live-venum.
        gt_hu_imseg-vepos = gt_live-vepos.
        gt_hu_imseg-tabix = if_imseg_tabix.
        APPEND gt_hu_imseg.
      ENDIF.
    ENDLOOP.
  ELSE.                                                     "v_n_451653
    lf_idxfr = sy-tabix.
    IF gt_live-sobkz EQ if_xvbfa_sobkz AND
       gt_live-sonum EQ if_xvbfa_sonum.
      gt_humseg_hu-venum       = gt_live-venum.
      gt_humseg_hu-vepos       = gt_live-vepos.
      gt_humseg_hu-quantity    = gt_live-vemng.
      gt_humseg_hu-vemeh       = gt_live-vemeh.
      gt_humseg_hu-imseg_tabix = if_imseg_tabix.
      PERFORM hu_fill_humseg_hu.
      APPEND gt_humseg_hu.
    ENDIF.
    lf_idxfr = lf_idxfr + 1.
    LOOP AT gt_live FROM lf_idxfr TO lf_idxto.
      IF gt_live-vbeln NE xlips-vbeln OR
         gt_live-posnr NE xlips-posnr.
        EXIT.
      ENDIF.
      gt_humseg_hu-venum       = gt_live-venum.
      gt_humseg_hu-vepos       = gt_live-vepos.
      gt_humseg_hu-quantity    = gt_live-vemng.
      gt_humseg_hu-vemeh       = gt_live-vemeh.
      gt_humseg_hu-imseg_tabix = if_imseg_tabix.
      PERFORM hu_fill_humseg_hu.
      APPEND gt_humseg_hu.
    ENDLOOP.
  ENDIF.                                                    "^_n_451653

ENDFORM.                               " HU_FILL_BEFI_HU_IMSEG
