*&---------------------------------------------------------------------*
*&      Form  HU_COMPLETENESS_CHECK
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LIKP_KZWAB  text
*      -->P_CF_SUBRC  text
*----------------------------------------------------------------------*
FORM hu_completeness_check  USING    if_likp_kzwab
                                     cf_subrc.

  LOOP AT gt_live.
    cf_subrc = 4.
    IF if_likp_kzwab CA ' I'.
* Buchung im zentralen System
      LOOP AT ximseg.
        IF ximseg-posnr = gt_live-posnr.
          cf_subrc = 0.
          EXIT.
        ENDIF.
      ENDLOOP.
    ELSEIF if_likp_kzwab EQ chard.
* Buchung im dezentralen System
      LOOP AT xlseg_com.
        IF xlseg_com-lvbps = gt_live-posnr.
          cf_subrc = 0.
          EXIT.
        ENDIF.
      ENDLOOP.
    ENDIF.
    IF cf_subrc > 0.
      EXIT.
    ENDIF.
  ENDLOOP.

ENDFORM.                    " HU_COMPLETENESS_CHECK


*&--------------------------------------------------------------------*
*&      Form  hu_get_ekpo
*&--------------------------------------------------------------------*
*       text
*---------------------------------------------------------------------*
*      -->IF_VGBEL   text
*      -->IF_VGPOS   text
*      -->ES_EKPO    text
*---------------------------------------------------------------------*
FORM hu_get_ekpo USING    if_vgbel TYPE vgbel               "SP_549474
                          if_vgpos TYPE vgpos
                 CHANGING es_ekpo TYPE ekpo.

  DATA: lt_ekpo  TYPE TABLE OF ekpo,
        lf_tabix LIKE sy-tabix.
  STATICS: st_ekpo TYPE TABLE OF ekpo.

  READ TABLE st_ekpo INTO es_ekpo WITH KEY ebeln = if_vgbel
                                     ebelp = if_vgpos+1(5)
                                     BINARY SEARCH.
  IF sy-subrc IS INITIAL.
    EXIT.
  ELSE.
    lf_tabix = sy-tabix.
    SELECT * FROM ekpo INTO TABLE lt_ekpo WHERE ebeln = if_vgbel
                       ORDER BY PRIMARY KEY.                "n_762297
    IF sy-subrc IS INITIAL.
      INSERT LINES OF lt_ekpo INTO st_ekpo INDEX lf_tabix.
      READ TABLE lt_ekpo INTO es_ekpo WITH KEY ebeln = if_vgbel
                                               ebelp = if_vgpos+1(5)
                                               BINARY SEARCH.
    ENDIF.
  ENDIF.
ENDFORM.                    " hu_get_ekpo

*&--------------------------------------------------------------------*
*&      Form  batch_managed
*&--------------------------------------------------------------------*
*       text
*---------------------------------------------------------------------*
*      -->IF_MATNR   text
*      -->IF_WERKS   text
*      -->EF_XCHAR   text
*---------------------------------------------------------------------*
FORM batch_managed USING if_matnr TYPE matnr
                         if_werks TYPE werks_d
                CHANGING ef_xchar TYPE xfeld.

  DATA: ls_mtcom   TYPE mtcom, ls_marc_md TYPE v_marc_md.

  CLEAR ef_xchar.
  ls_mtcom-maxtz = 50.
  ls_mtcom-kzmpn = 'X'.
  ls_mtcom-spras = sy-langu.
  ls_mtcom-kenng = 'MARCM'.
  ls_mtcom-matnr = if_matnr.
  ls_mtcom-werks = if_werks.
* MMACCESS_2015W1_ADJUSTED
  CALL FUNCTION 'MATERIAL_READ'
    EXPORTING
      schluessel = ls_mtcom
    IMPORTING
      matdaten   = ls_marc_md
    EXCEPTIONS
      OTHERS     = 99.
  IF NOT sy-subrc IS INITIAL.
    RAISE not_possible.
  ENDIF.
  IF NOT ls_marc_md-xchar IS INITIAL AND NOT
         ls_marc_md-xchpf IS INITIAL.
    ef_xchar = 'X'.
