  CHECK NOT xvbuk-pkstk CA ' A'.

  IF gt_hu_imseg[] IS INITIAL.
    IF NOT gt_humseg_hu[] IS INITIAL.
      CALL FUNCTION 'V51P_GLOBAL_TABLE_SAVE'.
    ENDIF.                                                    "v_XAN-SPM
*   EXIT.
    IF likpd-kzebu IS INITIAL.
      EXIT.
    ENDIF.                                                    "^_XAN-SPM
