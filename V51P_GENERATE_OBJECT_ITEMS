    IF NOT ct_verko IS INITIAL.
      REFRESH: lt_header_cap, lt_header_add,
               lt_header_tra, lt_hu_items, lt_hdr_pro.
      lf_vbeln = gs_header51-objkey.                        "note 682506
      INCLUDE incl_mv50a_packing_create.
    ENDIF.
    IF NOT lt_header_pro IS INITIAL.
* status wird nicht mehr benutzt:
      MODIFY lt_header_pro FROM ls_header_pro
          TRANSPORTING status WHERE status NE space."#EC CI_SORTSEQ

      IF NOT lt_hdr_pro IS INITIAL.
*        append lines of LT_HEADER_PRO to lt_hdr_pro.          "n_792080
        lt_hdr_pro_tmp = lt_header_pro.
        INSERT LINES OF lt_hdr_pro_tmp INTO TABLE lt_hdr_pro. "n_792080
      ELSE.
        lt_hdr_pro = lt_header_pro.
      ENDIF.
    ENDIF.
*... automatic packing via TA-creation only for Headers
    IF gs_header51-object = gc_obj_05.
      REFRESH: lt_hu_items.
    ENDIF.
    CALL FUNCTION 'V51F_PACKING_CREATE'
