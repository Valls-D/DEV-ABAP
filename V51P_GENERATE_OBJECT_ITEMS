FORM select_kzpgn CHANGING cs_item TYPE vepovb.
  DATA: ls_tvty  TYPE tvty, ls_mtcom TYPE mtcom, ls_mara TYPE mara,
        ls_mtcor TYPE mtcor.
  DATA: lf_subrc TYPE sysubrc.

  IF cs_item-vhart IS INITIAL.
    ls_mtcom-kenng = 'MARA'.
    ls_mtcom-maxtz = 50.
    ls_mtcom-kzmpn = charx.
    ls_mtcom-spras = sy-langu.
    ls_mtcom-matnr = cs_item-matnr.
    INCLUDE incl_clear_msg.
    CALL FUNCTION 'MATERIAL_READ'
      EXPORTING
        schluessel         = ls_mtcom
      IMPORTING
        matdaten           = ls_mara
        return             = ls_mtcor
      EXCEPTIONS
        material_not_found = 01
        error_message      = 02
        sales_not_found    = 03
        OTHERS             = 99.
    IF NOT sy-subrc IS INITIAL.
      IF NOT sy-msgid IS INITIAL.
        MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
                WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
                RAISING fatal_error.
      ELSE.
        MESSAGE e040(huselect) WITH cs_item-matnr RAISING fatal_error.
      ENDIF.
    ENDIF.
    cs_item-vhart = ls_mara-vhart.
  ENDIF.
  CHECK NOT cs_item-vhart IS INITIAL.
  IF cs_item-kzpgn IS INITIAL.
    CALL FUNCTION 'V51S_TVTY_SELECT_CHECK'
      EXPORTING
        if_vhart = cs_item-vhart
      IMPORTING
        es_tvty  = ls_tvty
        ef_rcode = lf_subrc.
    CHECK lf_subrc IS INITIAL.
    cs_item-kzpgn = ls_tvty-kzpgn.
  ENDIF.
ENDFORM.                    "select_kzpgn
