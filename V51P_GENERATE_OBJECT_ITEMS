*---------------------------------------------------------------------*
*            FORM CREATE_KOMPV
*---------------------------------------------------------------------*
FORM create_kompv USING    it_vekp TYPE vsep_t_vekp
                  CHANGING ct_kompv TYPE vsep_t_kompv.
  DATA: ls_kompv TYPE kompv.
  FIELD-SYMBOLS: <header> TYPE vekpvb.

  LOOP AT it_vekp ASSIGNING <header> WHERE uevel EQ space.  "n_1045112
    IF gs_header51-object = gc_obj_01 OR
       gs_header51-object = gc_obj_03.
      CHECK <header>-vpobj = gs_header51-object AND
            <header>-vpobjkey = gs_header51-objkey.
    ENDIF.
    IF <header>-magrv IS INITIAL.
      CONTINUE.
    ENDIF.
    ls_kompv-pobjkey = <header>-exidv.
    ls_kompv-velin   = '3'.
    MOVE-CORRESPONDING <header> TO ls_kompv.
    ls_kompv-matnr = <header>-vhilm.
    ls_kompv-opmng = 1.
    ls_kompv-vrkme = <header>-meins.
    ls_kompv-gewei = <header>-gewei_max.
    ls_kompv-volum = <header>-btvol.
    ls_kompv-voleh = <header>-voleh_max.
    APPEND ls_kompv TO ct_kompv.
  ENDLOOP.
ENDFORM.                    "CREATE_KOMPV
*---------------------------------------------------------------------*
*             FORM KOMPV_VERVOLLSTAENDIGEN
*---------------------------------------------------------------------*
FORM kompv_vervollstaendigen CHANGING ct_kompv TYPE vsep_t_kompv.
  DATA: ls_kompv TYPE kompv, ls_vekp TYPE vekpvb, ls_v51vp TYPE v51vp.

  LOOP AT ct_kompv INTO ls_kompv WHERE NOT pobjpos = space.
    CLEAR ls_v51vp.
    ls_v51vp-vbeln = ls_kompv-pobjkey.
    ls_v51vp-posnr = ls_kompv-pobjpos.
    CALL FUNCTION 'V51P_FIND_MATERIAL'
      EXPORTING
        is_v51vp         = ls_v51vp
      IMPORTING
        es_material_item = ls_v51vp
      EXCEPTIONS
        mat_not_found    = 01
        OTHERS           = 99.
    IF NOT sy-subrc IS INITIAL.
      DELETE ct_kompv.
      CONTINUE.
    ENDIF.
    MOVE-CORRESPONDING ls_v51vp TO ls_kompv.
*... Mengen analog zu aufbauen packgood im gf01 (opmng durch move-corr..
    CASE gs_header51-object.                                "HP_534053
      WHEN gc_obj_01 OR gc_obj_04.
        IF ls_v51vp-hu_lgort CA 'CDX'.
          ls_kompv-opmng = ls_v51vp-lf_opmng.
        ENDIF.
      WHEN gc_obj_02.
        IF ls_v51vp-lfimg < ls_v51vp-opmng.
          ls_kompv-opmng = ls_v51vp-lfimg.
        ENDIF.
      WHEN gc_obj_03.
      WHEN OTHERS.
        ls_kompv-opmng = ls_v51vp-lfimg.
    ENDCASE.
    IF NOT ls_kompv-opmng > 0.
      DELETE ct_kompv.
      CONTINUE.
    ENDIF.
    MODIFY ct_kompv FROM ls_kompv.
  ENDLOOP.
  LOOP AT ct_kompv INTO ls_kompv WHERE velin = '3'.
    ls_vekp-venum = ls_kompv-venum.
    IF ls_vekp-venum IS INITIAL.
      ls_vekp-exidv = ls_kompv-pobjkey.
    ENDIF.
    CALL FUNCTION 'V51P_FIND_HEADER'
      EXPORTING
        is_vekp   = ls_vekp
      IMPORTING
        es_header = ls_vekp
      EXCEPTIONS
        not_found = 01
        OTHERS    = 99.
    IF NOT sy-subrc IS INITIAL OR NOT ls_vekp-uevel IS INITIAL.
      DELETE ct_kompv.
      CONTINUE.
    ENDIF.
    MOVE-CORRESPONDING ls_vekp TO ls_kompv.
    ls_kompv-matnr = ls_vekp-vhilm.
    ls_kompv-opmng = 1.
    ls_kompv-vrkme = ls_vekp-meins.
    ls_kompv-gewei = ls_vekp-gewei_max.
    ls_kompv-volum = ls_vekp-btvol.
    ls_kompv-voleh = ls_vekp-voleh_max.
    MODIFY ct_kompv FROM ls_kompv.
  ENDLOOP.
ENDFORM.                    "KOMPV_VERVOLLSTAENDIGEN
*---------------------------------------------------------------------*
*               FORM KOMPV_AUFBAUEN_AUS_V51VP
*---------------------------------------------------------------------*
FORM kompv_aufbauen_aus_v51vp USING if_objkey TYPE v51ko-objkey
                              CHANGING ct_kompv TYPE vsep_t_kompv.
  DATA: ls_kompv TYPE kompv, ls_v51vp TYPE v51vp, ls_vekp TYPE vekpvb,
        lf_vbeln TYPE v51vp-vbeln.
  lf_vbeln = if_objkey(10).
  LOOP AT gt_v51vp INTO ls_v51vp WHERE vbeln = lf_vbeln.
    MOVE-CORRESPONDING ls_v51vp TO ls_kompv.
    IF gs_header51-object = gc_obj_01 AND ls_v51vp-hu_lgort CA 'CDX'.
      ls_kompv-opmng = ls_v51vp-lf_opmng.
    ENDIF.
    IF gs_header51-object = gc_obj_12 OR
       gs_header51-object = gc_obj_05 OR
       gs_header51-object = gc_obj_07 OR
       gs_header51-object = gc_obj_09.
      ls_kompv-opmng = ls_v51vp-lfimg.
    ENDIF.
    ls_kompv-velin = '1'.
    ls_kompv-pobjkey = ls_v51vp-vbeln.
    ls_kompv-pobjpos = ls_v51vp-posnr.
    CHECK ls_kompv-opmng > 0.
    APPEND ls_kompv TO ct_kompv.
  ENDLOOP.
ENDFORM.                    "KOMPV_AUFBAUEN_AUS_V51VP
*---------------------------------------------------------------------*
FORM determine_packgoods USING it_kompv TYPE vsep_t_kompv
                         CHANGING et_packgoods TYPE pdt_packgoods.
  DATA: ls_packgood LIKE packgood, ls_kompv LIKE kompv,
        lf_join     TYPE char4.

  DATA: ls_v51vp_help TYPE v51vp.                                       "{ ENHO AUTO_VHU_PO_V51P_PACKING_DE000 IS-A-HUM AM_HUM }
* IS_AUTO_VHU: Enhancement core packing dialog with HU references HURES "{ ENHO AUTO_VHU_PO_V51P_PACKING_DE000 IS-A-HUM AM_HUM }
ENHANCEMENT-POINT V51P_PACKING_DETERMINATION_01 SPOTS ES_SAPLV51P STATIC.
  LOOP AT it_kompv INTO ls_kompv WHERE velin = '1'.
    CLEAR ls_packgood.
    MOVE-CORRESPONDING gs_v51ko TO ls_packgood.
    ls_packgood-versart = gs_v51ko-vsart.
    MOVE-CORRESPONDING ls_kompv TO ls_packgood.
    ls_packgood-maxqua = ls_kompv-opmng.
ENHANCEMENT-SECTION     V51P_PACKING_DETERMINATION_02 SPOTS ES_SAPLV51P.
    CASE gs_header51-object.
      WHEN '01' OR '04'.
        ls_packgood-kunwe = gs_header51-kunnr.
      WHEN '03'.
        ls_packgood-lifnr = gs_header51-kunnr.
        "{ Begin ENHO AUTO_VHU_PO_V51P_PACKING_DE000 IS-A-HUM AM_HUM }
* for HUs with reference complete packing determination fields from
* references sales order, purchase order or delivery
* DI46C2-CRT4-HUM/PL
      WHEN '06' OR '07' OR '09' OR '12'.
        IF NOT ls_kompv-pobjpos = space.
          CLEAR ls_v51vp_help.
          ls_v51vp_help-vbeln = ls_kompv-pobjkey.
          ls_v51vp_help-posnr = ls_kompv-pobjpos.
          CALL FUNCTION 'V51P_FIND_MATERIAL'
            EXPORTING
              is_v51vp         = ls_v51vp_help
            IMPORTING
              es_material_item = ls_v51vp_help
            EXCEPTIONS
              mat_not_found    = 01
              OTHERS           = 99.
          IF NOT ls_v51vp_help-custord IS INITIAL.
            PERFORM add_packinst_determin_fields
                                    USING    ls_v51vp_help-custord
                                             ls_v51vp_help-custordit
                                             ls_v51vp_help-purord
                                             ls_v51vp_help-purordit
                                             ls_v51vp_help-dlvry
                                             ls_v51vp_help-dlvryit
                                    CHANGING ls_packgood.
          ENDIF.
        ENDIF.
* IS_AUTO_VHU: Enhancement core packing dialog with HU references HURES
        "{ End ENHO AUTO_VHU_PO_V51P_PACKING_DE000 IS-A-HUM AM_HUM }
    ENDCASE.
END-ENHANCEMENT-SECTION.
    ls_packgood-qunit_a = ls_kompv-vrkme.
    ls_packgood-qunit_b = ls_kompv-meins.
    ls_packgood-docnum  = ls_kompv-pobjkey.
    ls_packgood-docitem = ls_kompv-pobjpos.
* HU02 allows Materials Of Different Groups to be Packed together on to
* the same Packing Material Hence the below two lines are commented out.
*   ls_packgood-joingrp = ls_kompv-lgort.                  "NOTE 537593.
*   ls_packgood-joingrp+4 = ls_kompv-umlgo.                "NOTE 537593.
    APPEND ls_packgood TO et_packgoods.
  ENDLOOP.
ENDFORM.                    "DETERMINE_PACKGOODS

"{ Begin ENHO AUTO_VHU_PO_V51P_PACKING_DE000 IS-A-HUM AM_HUM }
*&---------------------------------------------------------------------*
*&      Form  add_packinst_determin_fields
*&---------------------------------------------------------------------*
FORM add_packinst_determin_fields USING uf_custord   TYPE pl_custord
                                        uf_custordit TYPE pl_custordit
                                        uf_purord    TYPE pl_purord
                                        uf_purordit  TYPE pl_purordit
                                        uf_dlvry     TYPE pl_dlvry
                                        uf_dlvryit   TYPE pl_dlvryit
                               CHANGING cs_packgood  TYPE packgood.

  DATA: ls_vbak    TYPE vbak,
        ls_vbapvb  TYPE vbapvb,
        ls_vbpa_ag TYPE vbpa,           "Auftraggeber
        ls_vbpa_we TYPE vbpa,           "Warenempf.
        ls_vbkd    TYPE vbkd,
        ls_likp    TYPE likpvb,
        ls_lips    TYPE lipsvb,
        ls_ekko    TYPE ekko,
        ls_ekpo    TYPE ekpo,
        ls_ekpv    TYPE ekpv.

  IF NOT uf_custord IS INITIAL.

    CALL FUNCTION 'VHUMISC_READ_CUSTORD'
      EXPORTING
        if_custord          = uf_custord
        if_custordit        = uf_custordit
      IMPORTING
        es_vbak             = ls_vbak
        es_vbapvb           = ls_vbapvb
        es_vbpa_ag          = ls_vbpa_ag
        es_vbpa_we          = ls_vbpa_we
        es_vbkd             = ls_vbkd
      EXCEPTIONS
        custord_not_found   = 1
        custordit_not_found = 2
        too_much_custordit  = 3
        vbkd_not_determined = 4
        vbpa_not_determined = 5
        OTHERS              = 6.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

*   change customer data
    cs_packgood-kunag     = ls_vbpa_ag-kunnr.
    cs_packgood-kunwe     = ls_vbpa_we-kunnr.
    cs_packgood-ablad     = ls_vbpa_we-ablad.
    cs_packgood-abrvw     = ls_vbak-abrvw.
    cs_packgood-route     = ls_vbapvb-route.
    cs_packgood-vstel     = ls_vbapvb-vstel.
*   cs_packgood-versart   = ls_vbkd-vsart.  already happened before

  ELSEIF NOT uf_purord IS INITIAL.

    CALL FUNCTION 'VHUMISC_READ_PURORD'
      EXPORTING
        if_purord           = uf_purord
        if_purordit         = uf_purordit
      IMPORTING
        es_ekko             = ls_ekko
        es_ekpo             = ls_ekpo
        es_ekpv             = ls_ekpv
      EXCEPTIONS
        purord_not_found    = 1
        purordit_not_found  = 2
        too_much_purordit   = 3
        ekpv_not_determined = 4
        OTHERS              = 5.
    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

*   change customer data
    cs_packgood-kunag     = ls_ekpv-kunag.
    cs_packgood-kunwe     = ls_ekpv-kunnr.
    cs_packgood-ablad     = ls_ekpv-ablad.
*   cs_packgood-abrvw     = ls_vbak-abrvw. "Gibt es das bei Bestellungen
    cs_packgood-route     = ls_ekpv-route.
    cs_packgood-vstel     = ls_ekpv-vstel.
*   cs_packgood-versart   = ls_vbkd-vsart. "Gibt es das bei Bestellungen

  ELSEIF NOT uf_dlvry IS INITIAL.

    CALL FUNCTION 'VHUMISC_READ_DLVRY'
      EXPORTING
        if_dlvry          = uf_dlvry
        if_dlvryit        = uf_dlvryit
      IMPORTING
        es_likp           = ls_likp
        es_lips           = ls_lips
      EXCEPTIONS
        dlvry_not_found   = 1
        dlvryit_not_found = 2
        too_much_dlvryit  = 3
        OTHERS            = 4.

    IF sy-subrc <> 0.
      MESSAGE ID sy-msgid TYPE sy-msgty NUMBER sy-msgno
              WITH sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4.
    ENDIF.

*   change customer data
    cs_packgood-kunag     = ls_likp-kunag.
    cs_packgood-kunwe     = ls_likp-kunnr.
    cs_packgood-ablad     = ls_likp-ablad.
    cs_packgood-abrvw     = ls_lips-abrvw.
    cs_packgood-route     = ls_likp-route.
    cs_packgood-vstel     = ls_likp-vstel.
*   cs_packgood-versart   = ls_vbkd-vsart.  already happened before

  ENDIF.

ENDFORM.                    " add_packinst_determin_fields
