*             following coding is processed if current aux.pack.mat ..
*             ... has no delivery item yet and should not get one
*             ... has already a delivery item which should be deleted
*             Remarque: update flag (kzupd) might be set for ct_genpos
*                     and for gt_xvekp if to delete delivery item
              IF  <header>-liefnr IS INITIAL
                  OR <item>-kzpgn = ' '
                  OR <header>-kunnr IS INITIAL AND <item>-kzpgn = 'A'
                  OR NOT <item>-vbeln IS INITIAL
                      AND <header>-liefnr <> <item>-vbeln.
                IF <item>-posnr_gen IS INITIAL.
*                 no delivery item yet and no creation of one ...
                  CONTINUE.
                ELSE.
*                 delivery item already exists but should be deleted
                  READ TABLE ct_genpos INTO ls_genpos
                                WITH KEY vhilm = <item>-matnr
                                         vbeln = <item>-vbeln
                                         posnr = <item>-posnr_gen
                                         BINARY SEARCH.
                  lf_subrc = sy-subrc.
                  lf_tabix = sy-tabix.
*                 for withdrawl we to take the right quantity: in case
*                 the quantity was modified, an entry is to be found
*                 in gt_yvepo with the quantity at item creation point
*                 of time ...
                  CLEAR lf_veanz.
                  READ TABLE gt_yvepo ASSIGNING <vepo>
                            WITH KEY venum = <item>-venum
                                     vepos = <item>-vepos
                            BINARY SEARCH.
                  IF sy-subrc IS INITIAL.
                    lf_veanz = <vepo>-veanz.
                  ELSE.
                    lf_veanz = <item>-veanz.
                  ENDIF.

                  IF lf_subrc IS INITIAL.
*                   corresponding delivery item line exists already
                    IF ls_genpos-updkz <> 'I'.
                      ls_genpos-updkz = 'U'.
                    ENDIF.
                    ls_genpos-lfimg_new =
                                  ls_genpos-lfimg_new - lf_veanz.
                    MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
                  ELSE.
                    lf_veanz =  -1 * lf_veanz.
*                   create a new delivery item line
                    PERFORM create_genpos_entry_aux
                                       USING    <item>-venum
                                                <item>-vepos
                                                <item>-vbeln
                                                lf_veanz
                                       CHANGING ct_genpos
                                                lf_tabix.
                  ENDIF.
                  <item>-updkz = 'U'.
                  CLEAR: <item>-posnr_gen, <item>-vbeln.
                ENDIF.
              ENDIF.

*             the follwing coding is processed to check if the current
*             aux.pack.mat should get / keep a delivery item
*             Remarque: update flag (kzupd) is set in the following
*             for ct_genpos, while for gt_xvekp / gt_vepo it is set
*             only in LV51PF42 after further checks of delivery status
              IF NOT <header>-liefnr IS INITIAL.
*               delivery relation exists
                IF <item>-kzpgn = 'B'
                  OR <item>-kzpgn = 'A'
                     AND NOT <header>-kunnr IS INITIAL.
*                 up to now nothing against delivery item creation
                  IF NOT <item>-lgort IS INITIAL.
                    READ TABLE ct_genpos INTO ls_genpos
                                   WITH KEY vhilm = <item>-matnr
                                            vbeln = <header>-liefnr
                                            werks = <item>-werks
                                            lgort = <item>-lgort
                                       BINARY SEARCH.
                  ELSEIF NOT <item>-werks IS INITIAL.
                    READ TABLE ct_genpos INTO ls_genpos
                                   WITH KEY vhilm = <item>-matnr
                                            vbeln = <header>-liefnr
                                            werks = <item>-werks
                                       BINARY SEARCH.
                  ELSE.
                    READ TABLE ct_genpos INTO ls_genpos
                                   WITH KEY vhilm = <item>-matnr
                                            vbeln = <header>-liefnr
                                       BINARY SEARCH.
                  ENDIF.
                  lf_tabix = sy-tabix.
                  lf_subrc = sy-subrc.

*                 change in quantity leads to entry in gt_yvepo with
*                 the current quantity on the data base, while in
*                 gt_xvepo the new quantity is given
                  READ TABLE gt_yvepo ASSIGNING <vepo>
                            WITH KEY venum = <item>-venum
                                     vepos = <item>-vepos
                            BINARY SEARCH.
                  IF sy-subrc IS INITIAL.
                    lf_veanz = <item>-veanz - <vepo>-veanz.
                  ELSE.
                    CLEAR lf_veanz.  "no change in quantity
                  ENDIF.

                  IF <header>-liefnr <> <item>-vbeln.
                    IF lf_subrc IS INITIAL.
*                     add to already existing delivery item line
                      CLEAR ls_venum.
                      ls_venum-venum = <item>-venum.
                      ls_venum-vepos = <item>-vepos.
                      APPEND ls_venum TO ls_genpos-hus.
                      IF NOT <item>-posnr_gen IS INITIAL.
*                       already existing item
                        ls_genpos-lfimg_new = ls_genpos-lfimg_new
                                  + lf_veanz.
                      ELSE.
*                       new item
                        ls_genpos-lfimg_new = ls_genpos-lfimg_new
                                  + <item>-veanz.
                      ENDIF.
                      IF NOT ls_genpos-updkz  = 'I'.
                        ls_genpos-updkz = 'U'.
                      ENDIF.
                      MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
                    ELSE.
*                     create new delivery item line
                      PERFORM create_genpos_entry_aux
                                         USING    <item>-venum
                                                  <item>-vepos
                                                  <header>-liefnr
                                                  <item>-veanz
                                         CHANGING ct_genpos
                                                  lf_tabix.

                    ENDIF.
                  ELSE.
*                   <header>-liefnr = <item>-vbeln -> keep the item
                    IF lf_subrc IS INITIAL.
*                     already existing delivery item line
                      ls_venum-venum = <item>-venum.
                      ls_venum-vepos = <item>-vepos.
                      APPEND ls_venum TO ls_genpos-hus.
*                     adapt quantity if it was changed
                      IF NOT lf_veanz IS INITIAL.
                        ls_genpos-lfimg_new =
                                     ls_genpos-lfimg_new + lf_veanz.
                        IF NOT ls_genpos-updkz  = 'I'.
                          ls_genpos-updkz = 'U'.
                        ENDIF.
                      ENDIF.
                      MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
                    ELSE.
*                     no delivery item line exists, but we do nothing
*                     as the user might have deleted the item line
*                     manually
                    ENDIF.
                  ENDIF.
                ELSE.
*                 case without delivery item creation ...
                ENDIF.  "IF <item>-kzpgn = 'B'
              ENDIF. "IF NOT <header>-liefnr IS INITIAL
            ENDLOOP. "LOOP AT gt_xvepo ASSIGNING <item>
          ENDIF.  "IF sy-subrc IS INITIAL
        ENDIF. "IF NOT lf_auxpackmat IS INITIAL

***********************************************************************
*     UPDATE CT_GENPOS - SECOND STEP : PACKAGING MATERIAL HEADERS     *
***********************************************************************

*       The following coding is processed if the current <header> ...
*       ... has no delivery item yet and should not get one
*       ... has already a delivery item which should be deleted
        IF   <header>-liefnr IS INITIAL
             OR <header>-kzpgn = ' '
             OR <header>-kunnr IS INITIAL AND <header>-kzpgn = 'A'
             OR NOT <header>-vbeln_gen IS INITIAL
                AND <header>-liefnr <> <header>-vbeln_gen.
          IF <header>-vbeln_gen IS INITIAL.
*           no delivery item yet and no creation of one
            CLEAR: <header>-liefnr, <header>-kunnr.
            CONTINUE.
          ELSE.
*           delivery item already exists but should be deleted
            READ TABLE ct_genpos INTO ls_genpos
                               WITH KEY vhilm = <header>-vhilm
                                        vbeln = <header>-vbeln_gen
                                        posnr = <header>-posnr_gen
                                        BINARY SEARCH.
            lf_subrc = sy-subrc.
            lf_tabix = sy-tabix.
            IF lf_subrc IS INITIAL.
*             corresponding delivery item line exists already
              IF ls_genpos-updkz <> 'I'.
                ls_genpos-updkz = 'U'.
              ENDIF.
              ls_genpos-lfimg_new = ls_genpos-lfimg_new - 1.
              MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
            ELSE.
*             create a new delivery item line
*             we enter this case only in case there were already
*             inconsistencies or manually deleted delivery items
              PERFORM create_genpos_entry
                                   USING    <header>-venum
                                            -1
                                            <header>-vbeln_gen
                                   CHANGING ct_genpos
                                            lf_tabix.
            ENDIF.
            <header>-updkz = 'U'.
            CLEAR: <header>-vbeln_gen, <header>-posnr_gen.
          ENDIF. "IF <header>-vbeln_gen IS initial.
        ENDIF. "IF <header>-liefnr IS initial ...

*       the follwing coding is processed to check if the current
*       <header> should get / keep a delivery item
        IF NOT <header>-liefnr IS INITIAL.
*         delivery relation exists ...
          CLEAR ls_venum.
          IF <header>-kzpgn = 'B'
            OR <header>-kzpgn = 'A' AND NOT <header>-kunnr IS INITIAL.
*           up to now nothing against delivery item creation ...
            IF NOT <header>-lgort IS INITIAL.
              READ TABLE ct_genpos INTO ls_genpos
                                   WITH KEY vhilm = <header>-vhilm
                                            vbeln = <header>-liefnr
                                            werks = <header>-werks
                                            lgort = <header>-lgort
                                       BINARY SEARCH.
            ELSEIF NOT <header>-werks IS INITIAL.
              READ TABLE ct_genpos INTO ls_genpos
                                   WITH KEY vhilm = <header>-vhilm
                                            vbeln = <header>-liefnr
                                            werks = <header>-werks
                                   BINARY SEARCH.
            ELSE.
              READ TABLE ct_genpos INTO ls_genpos
                                   WITH KEY vhilm = <header>-vhilm
                                            vbeln = <header>-liefnr
                                   BINARY SEARCH.
            ENDIF.
            lf_subrc = sy-subrc.
            lf_tabix = sy-tabix.

            IF <header>-liefnr <> <header>-vbeln_gen.
*             create an additional delivery item
              IF lf_subrc IS INITIAL.
*               add to already existing delivery item line
                ls_venum-venum = <header>-venum.
                APPEND ls_venum TO ls_genpos-hus.
                IF ls_genpos-updkz <> 'I'.
                  ls_genpos-updkz = 'U'.
                ENDIF.
                ls_genpos-lfimg_new = ls_genpos-lfimg_new + 1.
                MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
              ELSE.
*               create new delivery item line
                PERFORM create_genpos_entry
                                     USING    <header>-venum
                                              1
                                              <header>-liefnr
                                     CHANGING ct_genpos
                                              lf_tabix.
              ENDIF.

            ELSE.
*             keep already existing delivery item
              IF lf_subrc IS INITIAL.
*               add to already existing delivery item line
                ls_venum-venum = <header>-venum.
                APPEND ls_venum TO ls_genpos-hus.
                MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
              ELSE.
*               no delivery item line exists, but we do nothing as
*               the user might have deleted the item line manually
              ENDIF.
            ENDIF. "IF <header>-liefnr <> <header>-vbeln_gen.
          ELSE.
*           delivery item should not exist -> mark for deletion
*           diminish ct_genpos, clear dynamic fields?
          ENDIF. "IF <header>-kzpgn = 'B'
        ENDIF.  "IF NOT <header>-liefnr IS initial
      ENDLOOP. "LOOP AT gt_xvekp ASSIGNING <header>
    ENDIF.  "IF is_object-object = gc_obj_04.

***********************************************************************
*     PROCESSING CT_GENPOS                                            *
***********************************************************************

*   final checks and resorting of ct_genpos
    DELETE ct_genpos WHERE updkz IS INITIAL.
    CLEAR: lf_vbeln.
    CASE is_object-object.
      WHEN gc_obj_01 OR gc_obj_03.
      WHEN gc_obj_04.
        SORT ct_genpos BY vbeln posnr.
        LOOP AT ct_genpos INTO ls_genpos.
          ls_genpos-id = sy-tabix.
          MODIFY ct_genpos FROM ls_genpos.
          IF NOT lf_vbeln IS INITIAL AND ls_genpos-vbeln <> lf_vbeln.
*           process all ct_genpos lines belonging to the same delivery
*           before performing 'delivery_upd_for_package_mat'.
            PERFORM delivery_upd_for_package_mat
                                      TABLES    lt_req
                                                        et_ret "HP433492
                                                 USING    lf_vbeln
                                                 CHANGING ct_genpos.
            IF et_req IS REQUESTED.                         "v_571656
              APPEND LINES OF lt_req TO et_req.
            ENDIF.                                          "^_571656
            REFRESH: lt_req.
          ENDIF.
          CLEAR ls_req.
          ls_req-id            = ls_genpos-id.
          ls_req-document_type = gc_vbobj_delivery.
          ls_req-document_numb = ls_genpos-vbeln.
          ls_req-document_item = ls_genpos-posnr.
          IF ls_genpos-lfimg_new < 0 OR ls_genpos-updkz = 'D'.
            CLEAR ls_genpos-lfimg_new.
          ENDIF.
          ls_req-quantity_sales_uom = ls_genpos-lfimg_new.
          ls_req-quantity_base__uom = ls_genpos-lfimg_new.
          ls_req-material_long      = ls_genpos-vhilm.
          ls_req-material_customer  = ls_genpos-vhilm_ku.   "SP_599130
          ls_req-plant              = ls_genpos-werks.
          ls_req-stge_loc           = ls_genpos-lgort.
          ls_req-item_type          = 'C'.            "Posar C = Verp.
          ls_req-tare_wght          = ls_genpos-tarag.
          ls_req-unit_of_wt         = ls_genpos-gewei.
          ls_req-tare_vol           = ls_genpos-tavol.
          ls_req-volumeunit         = ls_genpos-voleh.
          APPEND ls_req TO lt_req.
*         ls_req-id = sy-tabix.
*         modify lt_req from ls_req index sy-tabix.
          lf_vbeln = ls_genpos-vbeln.
        ENDLOOP.
        IF NOT lt_req IS INITIAL.
          PERFORM delivery_upd_for_package_mat
                                      TABLES    lt_req
                                                        et_ret "HP433492
                                               USING    lf_vbeln
                                               CHANGING ct_genpos.
          IF et_req IS REQUESTED.                           "v_571656
            APPEND LINES OF lt_req TO et_req.
          ENDIF.                                            "^_571656
        ENDIF.
    ENDCASE.
    DELETE ct_genpos WHERE updkz = updkz_delete.
    IF NOT lt_ret IS INITIAL.
      APPEND lt_ret TO et_ret.                              "n_554293
    ENDIF.
  ENDIF.
ENDFUNCTION.


