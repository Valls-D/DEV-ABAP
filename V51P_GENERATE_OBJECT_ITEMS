    READ TABLE lt_genpos INTO ls_genpos                     "SP_549167
                                 WITH KEY vbeln = <header>-vbeln_gen
                                          posnr = <header>-posnr_gen.
    lf_tabix = sy-tabix.
    IF sy-subrc IS INITIAL.
      ls_genpos-lfimg_new = ls_genpos-lfimg_new - 1.
      IF ls_genpos-lfimg_new < 0. ls_genpos-lfimg_new = 0. ENDIF.
      ls_genpos-lfimg = ls_genpos-lfimg_new.
      PERFORM position_generiert_aendern_1(sapfv50p)
                       USING charp   ls_genpos-posnr
                             ls_genpos-lfimg_new ls_genpos-vrkme
                             space space 'X'.
      IF ls_genpos-lfimg_new = 0.                           "v_976740
        PERFORM xlips_loeschen(sapfv50p) USING space 0.
        DELETE lt_genpos INDEX lf_tabix.
      ELSE.
        MODIFY lt_genpos FROM ls_genpos INDEX lf_tabix.
