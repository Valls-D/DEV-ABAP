  IF NOT <item>-gewei IS INITIAL AND NOT <item>-brgew IS INITIAL
     AND NOT <item>-veanz IS INITIAL.                       " v_545374
    ls_genpos-tarag = <item>-brgew / <item>-veanz.          " ^_545374
    ls_genpos-gewei = <item>-gewei.
  ENDIF.
  IF NOT <item>-voleh IS INITIAL AND NOT <item>-volum IS INITIAL
     AND NOT <item>-veanz IS INITIAL.                       " v_545374
    ls_genpos-tavol = <item>-volum / <item>-veanz.          " ^_545374
    ls_genpos-voleh = <item>-voleh.
  ENDIF.
  CLEAR: ls_venum.
  IF if_initquantity > 0.
*   in case of creation we add the aux.pack.mat to subtable HUS
    ls_venum-venum = <item>-venum.
    ls_venum-vepos = <item>-vepos.
    APPEND ls_venum TO ls_genpos-hus.
  ENDIF.
  ls_genpos-updkz = 'I'.
  INSERT ls_genpos INTO ct_genpos INDEX cf_tabix.
ENDFORM.                    "create_genpos_entry_aux
