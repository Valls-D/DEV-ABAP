FORM create_genpos_entry
                       USING    if_venum  TYPE venum
                                if_initquantity TYPE i
                                if_delivery TYPE vbeln
                       CHANGING ct_genpos TYPE hum_genpos_t
                                cf_tabix  TYPE sytabix.

  DATA: ls_venum  TYPE huitem_key,
        ls_genpos TYPE hum_del_genpos,
        lf_z      TYPE sytabix,
        lf_n      TYPE sytabix,
        lf_gew    TYPE gewei,
        lf_vol    TYPE voleh.
  FIELD-SYMBOLS: <header> TYPE vekpvb,
                 <item>   TYPE vepovb.

  READ TABLE gt_xvekp ASSIGNING <header>
                    WITH KEY venum = if_venum
                    BINARY SEARCH.

  IF NOT sy-subrc IS INITIAL.
    READ TABLE gt_yvekp ASSIGNING <header>
                    WITH KEY venum = if_venum
                    BINARY SEARCH.
  ENDIF.

  CHECK sy-subrc IS INITIAL.
  CLEAR: ls_genpos, ls_venum.
  ls_genpos-vhilm = <header>-vhilm.
  ls_genpos-vhilm_ku = <header>-vhilm_ku.                   "SP_599130
  ls_genpos-lgort = <header>-lgort.
  ls_genpos-werks = <header>-werks.
  ls_genpos-vbeln = if_delivery.
  CLEAR: ls_genpos-posnr.
  ls_genpos-vrkme = <header>-meins.
  ls_genpos-lfimg = 0.
  ls_genpos-lfimg_new = if_initquantity.
  IF NOT <header>-gewei IS INITIAL
          AND NOT <header>-tarag IS INITIAL.
    ls_genpos-tarag = <header>-tarag.
    ls_genpos-gewei = <header>-gewei.
  ENDIF.
  IF NOT <header>-voleh IS INITIAL
       AND NOT <header>-tavol IS INITIAL.
    ls_genpos-tavol = <header>-tavol.
    ls_genpos-voleh = <header>-voleh.
  ENDIF.
  IF ( NOT <header>-gewei IS INITIAL AND                    "SP_574129
       NOT <header>-tarag IS INITIAL ) OR
     ( NOT <header>-voleh IS INITIAL AND
       NOT <header>-tavol IS INITIAL ).
    READ TABLE gt_xvepo TRANSPORTING NO FIELDS
                        WITH KEY venum = <header>-venum
                        BINARY SEARCH.
    IF sy-subrc IS INITIAL.
      LOOP AT gt_xvepo ASSIGNING <item> FROM sy-tabix.
        IF <item>-venum <> <header>-venum. EXIT. ENDIF.
        CHECK <item>-velin = 2.
        IF NOT <item>-gewei IS INITIAL AND
           NOT <item>-brgew IS INITIAL.
          IF ls_genpos-gewei = <item>-gewei.
            ls_genpos-tarag = ls_genpos-tarag - <item>-brgew.
          ELSE.
            PERFORM conversion_factor_get
                                     USING ls_genpos-gewei
                                           <item>-gewei
                                  CHANGING lf_z lf_n lf_gew.
            ls_genpos-tarag = ls_genpos-tarag -
                           ( <item>-brgew * lf_z / lf_n ).
          ENDIF.
        ENDIF.
        IF NOT <item>-voleh IS INITIAL AND
           NOT <item>-volum IS INITIAL.
          IF ls_genpos-voleh = ls_genpos-voleh.
            ls_genpos-tavol = ls_genpos-tavol - <item>-volum.
          ELSE.
            PERFORM conversion_factor_get
                                     USING ls_genpos-voleh
                                           <item>-voleh
                                     CHANGING lf_z lf_n lf_vol.
            ls_genpos-tavol = ls_genpos-tavol -
                           ( <item>-volum * lf_z / lf_n ).
          ENDIF.
        ENDIF.
      ENDLOOP.
      IF ls_genpos-tarag < 0. CLEAR ls_genpos-tarag. ENDIF.
      IF ls_genpos-tavol < 0. CLEAR ls_genpos-tavol. ENDIF.
    ENDIF.
  ENDIF.
  ls_genpos-updkz = 'I'.
  IF if_initquantity > 0.
    ls_venum-venum = if_venum.
    APPEND ls_venum TO ls_genpos-hus.
  ENDIF.
  INSERT ls_genpos INTO ct_genpos INDEX cf_tabix.
ENDFORM.                    "create_genpos_entry

