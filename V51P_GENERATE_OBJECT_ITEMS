                     USING charp   ls_genpos-posnr
                           ls_genpos-lfimg_new ls_genpos-vrkme
                           space space 'X'.
    IF ls_genpos-lfimg_new = 0.                             "v_976740
      PERFORM xlips_loeschen(sapfv50p) USING space 0.
      DELETE ct_genpos INDEX lf_tabix.
    ELSE.
      MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
    ENDIF.                                                  "^_976740
    CLEAR: cs_header-posnr_gen, cs_header-vbeln_gen.
