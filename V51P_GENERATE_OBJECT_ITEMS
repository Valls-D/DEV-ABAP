        it_header_capa = lt_header_cap
        it_header_add  = lt_header_add
        it_header_tra  = lt_header_tra
        it_items       = lt_hu_items
        it_item_sernr  = lt_hu_item_sernr                   "HP_511691
      IMPORTING
        et_header      = et_header
      CHANGING
        ct_messages    = et_messages
      EXCEPTIONS
        OTHERS         = 99.
    IF NOT sy-subrc IS INITIAL OR et_header IS INITIAL.
      EXIT.
    ENDIF.
    CHECK NOT et_header[] IS INITIAL.
    ef_existing_data = charx.
    REFRESH: ct_verko, ct_verpo, lt_kompv, lt_pdshpunit.
    PERFORM create_kompv USING    et_header
                         CHANGING lt_kompv.
    CHECK NOT lt_kompv[] IS INITIAL.
  ENDDO.

