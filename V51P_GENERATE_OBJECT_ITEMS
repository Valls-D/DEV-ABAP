        lf_subrc       TYPE sy-subrc, lt_genpos TYPE vsep_t_genpos,
        ls_matnr       TYPE v_matnr_hu, ls_tvty TYPE tvty,
        lf_create_item TYPE xflag,
        lt_assigned    TYPE gtyt_x_venum,
        lf_x_object    TYPE hu_object.
  FIELD-SYMBOLS: <header> TYPE vekpvb, <item> TYPE vepovb.
  DATA: lf_z   TYPE sytabix, lf_n TYPE sytabix,
        lf_gew TYPE gewei, lf_vol TYPE voleh.
  DATA: lf_varkey TYPE rstable-varkey.

  TYPES: BEGIN OF lty_velin2_quan,                          "SP_657128
           venum TYPE venum,
           vepos TYPE vepos,
           veanz TYPE veanz,
         END OF lty_velin2_quan.
