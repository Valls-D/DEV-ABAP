  DATA: lf_vbeln LIKE likp-vbeln.                           " 682506
  DATA lv_profile_type TYPE lohum_de_upb_profile_type.
  DATA: l_badi_autopack_sap TYPE REF TO badi_hu_autopack_sap.

  CONSTANTS: lc_application TYPE char1 VALUE '1'.

  lt_kompv[] = it_kompv[].
  CASE if_call.
    WHEN 'A'.
      PERFORM kompv_aufbauen_aus_v51vp USING gs_header51-objkey
                                       CHANGING lt_kompv.
    WHEN 'D'.
      PERFORM kompv_vervollstaendigen CHANGING lt_kompv.
    WHEN 'E'.
      IF gs_header51-object IS INITIAL.
        gs_header51-object = gc_obj_05.
      ENDIF.
      READ TABLE it_kompv INTO ls_kompv INDEX 1.
*<<<<< begin of insert HP_439638   >>>>>>>>>>>>>>>>
      IF gs_hu_mm-lgnum IS INITIAL.
        gs_hu_mm-lgnum = ls_kompv-lgnum.
      ENDIF.
      IF gs_hu_mm-werks IS INITIAL.
        gs_hu_mm-werks = ls_kompv-werks.
      ENDIF.
      IF gs_hu_mm-lgort IS INITIAL.
        gs_hu_mm-lgort = ls_kompv-lgort.
      ENDIF.
*<<<<<<< end of insert HP_439638 >>>>>>>>>>>>>>>>>>>>
      gs_header51-objkey = ls_kompv-pobjkey.
      gs_header51-profile = '0016'.
  ENDCASE.
  IF lf_schleifen IS INITIAL. lf_schleifen = 1. ENDIF.
* Bestimmen der Anzahl Verpackungsstufen (und ggf. Ändern von kompv)
  CALL CUSTOMER-FUNCTION '003'
    EXPORTING
      is_v51ko = gs_v51ko
      it_v51vp = gt_v51vp
      it_vekp  = gt_xvekp
    CHANGING
      cf_loops = lf_schleifen
      ct_kompv = lt_kompv.
  IF lt_kompv IS INITIAL.
* message i106(HUGENERAL).
    PERFORM set_hu_msg USING    space 'HUGENERAL' 'I' '106'
                                space space space space
                       CHANGING et_messages.
    EXIT.
  ENDIF.
  ls_pdt_obj-objtype = gs_header51-object.
  ls_pdt_obj-objkey  = gs_header51-objkey.
  DO lf_schleifen TIMES.
    lf_loop = lf_loop + 1.
