          CALL FUNCTION 'V51P_XVEKP_YVEKP_UPDATE'           "SP_591091
            EXPORTING
              if_updkz = updkz_update
              is_vekp  = <header>
            EXCEPTIONS
              OTHERS   = 0.
        ENDIF.
      ENDIF.
    ELSE.                                             "Lieferpos. gen
      MOVE-CORRESPONDING <header> TO ls_510.
      READ TABLE gt_xvepo TRANSPORTING NO FIELDS
                          WITH KEY venum = <header>-venum
                          BINARY SEARCH.
      IF sy-subrc IS INITIAL.
        LOOP AT gt_xvepo ASSIGNING <item> FROM sy-tabix.
          IF <item>-venum <> <header>-venum. EXIT. ENDIF.
