          IMPORTING
            packitems           = lt_packitems
            return_code         = lf_retcode
          EXCEPTIONS
            failure             = 1
            profile_not_found   = 2
            profile_wrong       = 3
            creation_failed     = 4
            no_packgood_found   = 5
            packinstr_deleted   = 6
            packinstr_not_found = 7
            OTHERS              = 99.

        IF ( NOT sy-subrc IS INITIAL OR lf_retcode = 1 ) AND
           lt_pdshpunit IS INITIAL. "keine PV und kein Kundenvorschlag
          IF sy-msgid IS INITIAL.
* message i081(HUGENERAL).
            PERFORM set_hu_msg USING    space 'HUGENERAL' 'I' '081'
                                        space space space space
                               CHANGING et_messages.
          ELSE.
            PERFORM set_hu_msg USING   space sy-msgid 'I' sy-msgno
                                       sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
                               CHANGING et_messages.
          ENDIF.
        ENDIF.
      ENDIF.
      IF NOT lt_packitems IS INITIAL.
        CALL FUNCTION 'VHUPILE_CREATE_HU_PROPOSALS'
          EXPORTING
            application     = '1'
            packitems       = lt_packitems
            object          = ls_pdt_obj
            profile         = gs_header51-profile
          IMPORTING
            t_hd_prp        = lt_header_pro
            t_hd_cap        = lt_header_cap
            t_hd_add        = lt_header_add
            t_hd_tra        = lt_header_tra
            t_items         = lt_hu_items
          EXCEPTIONS
            creation_failed = 1
            OTHERS          = 2.
        IF NOT sy-subrc IS INITIAL.
          IF sy-msgid IS INITIAL OR sy-msgty = 'S'.
* message i082(HUGENERAL).
            PERFORM set_hu_msg USING    space 'HUGENERAL' 'I' '082'
                                        space space space space
                               CHANGING et_messages.

          ELSE.
            PERFORM set_hu_msg USING   space sy-msgid sy-msgty sy-msgno
                                       sy-msgv1 sy-msgv2 sy-msgv3 sy-msgv4
                               CHANGING et_messages.
          ENDIF.
        ENDIF.
      ENDIF.
    ENDIF.
*-----Begin: Application :IS-MP-LE, Switch:/SAPMP/HUM_PACKAGING ,HUM/Packaging------*
*-/SAPMP/ - Automatisches Verpacken von Kabeln auf Trommel      "/SAPMP/
    CALL FUNCTION '/SAPMP/PROPOSAL'                             "/SAPMP/
