    exporting
      if_lfart                =  ls_header-lfart
    changing
      cs_tvlk                 =  ls_tvlk
   EXCEPTIONS
*     NO_KEY_SPECIFIED        = 1
*     NO_VALUE_SELECTED       = 2
     OTHERS                  = 3.

  if sy-subrc is initial.
* Is it allowed to add items without reference?
    if ls_tvlk-pobed = '201'.     " 201 => NO not allowed
      RETURN.
    endif.
  endif.
* end of note 2984970

  lt_genpos[] = it_genpos[].
  SORT lt_genpos BY vhilm vbeln werks lgort.
  lf_delivery = gs_header51-objkey(10).
  LOOP AT gt_yvekp ASSIGNING <header> WHERE posnr_gen NE space AND
                                          ( updkz = updkz_delete OR
