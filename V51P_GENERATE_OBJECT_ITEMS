FUNCTION v51p_generate_object_items.
*"----------------------------------------------------------------------
*"*"Local Interface:
*"  IMPORTING
*"     REFERENCE(IF_GENERATE) TYPE  XFELD DEFAULT SPACE
*"     REFERENCE(IS_OBJECT) TYPE  HUM_OBJECT
*"     REFERENCE(ITX_DELIVERIES) TYPE  LESHP_DELIVERY_T OPTIONAL
*"  TABLES
*"      ET_RET STRUCTURE  BAPIRET2 OPTIONAL
*"      ET_REQ STRUCTURE  BAPIDELICIOUSREQUEST OPTIONAL
*"  CHANGING
*"     REFERENCE(CT_GENPOS) TYPE  HUM_GENPOS_T OPTIONAL
*"  EXCEPTIONS
*"      FATAL_ERROR
*"----------------------------------------------------------------------
* >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
* !!! THIS FUNCTION MODULE WAS SIGNIFICANTLY MODIFIED BY NOTE 776230 !!!
* not all changes were explicitely marked - this concerns especially
* changes in comments entered to increase readability of the coding
* >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>


  IF NOT gs_header51-object = gc_obj_04.
    PERFORM create_del_item_old USING if_generate ct_genpos is_object.
  ELSE.
    TYPES: BEGIN OF ltyp_dlvstatus,
             vbeln      TYPE vv_belnr,
             kunnr      TYPE kunnr,
             chgeallowd TYPE xfeld,
           END OF ltyp_dlvstatus.

    TYPES    ttyp_dlvstatus TYPE SORTED TABLE OF ltyp_dlvstatus
             WITH UNIQUE KEY vbeln.


    DATA: lt_header TYPE hum_hu_header_t,
          lt_items  TYPE hum_hu_item_t,
          lt_req    TYPE bapideliciousrequest OCCURS 0.
    DATA: ls_venum    TYPE huitem_key,
          ls_header51 TYPE header51,
          ls_header   TYPE vekpvb,
          ls_item     TYPE vepovb,
          ls_genpos   TYPE hum_del_genpos,
          ls_matnr    TYPE v_matnr_hu,
          ls_tvty     TYPE tvty,
          ls_req      TYPE bapideliciousrequest.
    DATA: lf_delivery     TYPE vv_belnr,
          lf_tabix        TYPE sytabix,
          lf_del          TYPE xfeld,
          lf_max          TYPE sytabix,
          lf_vbeln        TYPE vv_belnr,
          lf_kunnr        TYPE kunnr,
          lf_subrc        TYPE sysubrc,
****          lf_z         TYPE sytabix,
****          lf_n         TYPE sytabix,
****          lf_gewei_tmp TYPE gewei,
****          lf_voleh_tmp TYPE voleh,
****          lf_gew       TYPE gewei,"                            SP_574129
****          lf_vol       TYPE voleh,
****          lt_ret       TYPE bapiret2 OCCURS 0 WITH HEADER LINE."n_554293
****
****
****    FIELD-SYMBOLS: <item>       TYPE vepovb,
****                   <header>     TYPE vekpvb,
****                   <header_top> TYPE vekpvb,
****                   <header2>    TYPE vekpvb,
****                   <x_del>      TYPE leshp_delivery_s,
****                   <vbpa>       TYPE vbpavb,
****                   <vepo>       TYPE vepovb.
****
****    SORT ct_genpos BY vhilm vbeln werks lgort.
****    MODIFY gt_xvekp FROM ls_header TRANSPORTING liefnr kunnr
****                                   WHERE NOT liefnr IS initial OR
****                                         NOT kunnr IS initial.
*****.. löschen von generierten PHM-Positionen gelöschter HUs
****   LOOP AT gt_yvepo ASSIGNING <item> WHERE NOT posnr_gen IS initial AND
****                                           updkz CA 'DE'.
****      CLEAR: ls_genpos, ls_venum.
****      INCLUDE incl_obj_item_crea01.
****    ENDLOOP.
*****eject
*****.. Liefermenge der zu löschenden HUs reduzieren
**** LOOP AT gt_yvekp ASSIGNING <header> WHERE NOT posnr_gen IS initial AND
****                                           updkz CA 'DE'.
****      CHECK <header>-vpobj = is_object-object.
****      CLEAR: ls_genpos, ls_venum.
****      INCLUDE incl_obj_item_crea02.
****    ENDLOOP.
*****eject
***** Im folgenen nur für Transport da zu schlechte Performance für LF

          lf_veanz        TYPE veanz,
          lt_ret          TYPE bapiret2 OCCURS 0 WITH HEADER LINE, "n_554293
          lf_nestlevels   TYPE i,                           "v_776230
          ls_dlvstatus    TYPE ltyp_dlvstatus,
          lt_dlvstatus    TYPE ttyp_dlvstatus,
          lf_dlvlink      TYPE xfeld,
          lf_dlvlinkprio1 TYPE xfeld,
          lf_dlvlinkprio2 TYPE xfeld,
          lf_dlvlinkprio3 TYPE xfeld,
          lf_auxpackmat   TYPE xfeld.

    FIELD-SYMBOLS: <item>         TYPE vepovb,
                   <header>       TYPE vekpvb,
                   <header_top>   TYPE vekpvb,
                   <header_kzunt> TYPE vekpvb,
                   <header2>      TYPE vekpvb,
                   <header_gt>    TYPE vekpvb,
                   <x_del>        TYPE leshp_delivery_s,
                   <vbpa>         TYPE vbpavb,
                   <vepo>         TYPE vepovb.



    SORT ct_genpos BY vhilm vbeln werks lgort.
    MODIFY gt_xvekp FROM ls_header TRANSPORTING liefnr kunnr
                                   WHERE NOT liefnr IS INITIAL OR
                                         NOT kunnr IS INITIAL.
*   remark: depending on the delivery status etc. it might be that the
*   modification of delivery items for packaging material isn't
*   allowed anymore. the corresponding checks are implemented on the
*   one hand in this function module (when modifying an already
*   existing item) and on the other hand in LV51PF42 (when creating
*   a new item).
*   extract dlv. movement status into lt_dlvstatus for faster checking
    LOOP AT itx_deliveries ASSIGNING <x_del>.
      IF <x_del>-head_status-wbstk = 'C'.
        CLEAR ls_dlvstatus-chgeallowd.
      ELSE.
        ls_dlvstatus-chgeallowd = charx.
      ENDIF.
      ls_dlvstatus-vbeln = <x_del>-head-vbeln(10).
      IF cl_sd_doc_category_util=>is_delivery_outgoing( iv_vbtyp = <x_del>-head-vbtyp ).   "(Ret.LF hat auch WE!)
        ls_dlvstatus-kunnr = <x_del>-head-kunnr.
      ELSE.
        ls_dlvstatus-kunnr = <x_del>-head-lifnr.
      ENDIF.
      INSERT ls_dlvstatus INTO TABLE lt_dlvstatus.
    ENDLOOP.

***********************************************************************
*     PROCESSING DELIVERY ITEMS FOR DELETED HUS                       *
***********************************************************************

*.. reduce delivery quantity for deleted aux.pack.mat
    LOOP AT gt_yvepo ASSIGNING <item>
                   WHERE NOT posnr_gen IS INITIAL
                   AND updkz CA 'DE'.
      CLEAR: ls_genpos, ls_venum.
      IF is_object-object = '04'.             "Transport
        READ TABLE gt_yvekp ASSIGNING <header>
                            WITH KEY venum = <item>-venum
                            BINARY SEARCH.
        IF NOT sy-subrc IS INITIAL.
          READ TABLE gt_xvekp ASSIGNING <header>
                              WITH KEY venum = <item>-venum
                              BINARY SEARCH.
          CHECK sy-subrc IS INITIAL.
        ENDIF.
        CHECK <header>-vpobj = gc_obj_04.
        lf_delivery = <item>-vbeln.
      ELSE.
        lf_delivery = is_object-objkey(10).
      ENDIF.
*     check if item change is possible for current delivery
      IF NOT lf_delivery IS INITIAL.
        READ TABLE lt_dlvstatus INTO ls_dlvstatus
                               WITH KEY vbeln = lf_delivery
                               BINARY SEARCH.
        CHECK sy-subrc IS INITIAL.
        CHECK NOT ls_dlvstatus-chgeallowd IS INITIAL.
      ENDIF.

      READ TABLE ct_genpos INTO ls_genpos
                           WITH KEY vhilm = <item>-matnr
                                    vbeln = lf_delivery
                                    posnr = <item>-posnr_gen
                                    BINARY SEARCH.
      lf_tabix = sy-tabix.
      lf_veanz = <item>-veanz.

      IF sy-subrc IS INITIAL.
*       delivery item line still exists
        ls_genpos-lfimg_new = ls_genpos-lfimg_new - lf_veanz.
        ls_venum-venum = <item>-venum.
        ls_venum-vepos = <item>-vepos.
        CLEAR: <item>-posnr_gen, <item>-vbeln.
        IF <item>-updkz = 'E'.
          CLEAR <item>.
        ENDIF.
        IF ls_genpos-updkz IS INITIAL.
          ls_genpos-updkz = 'U'.
        ENDIF.
        MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
      ELSE.
        lf_veanz =  -1 * lf_veanz.
        PERFORM create_genpos_entry_aux
                                USING    <item>-venum
                                         <item>-vepos
                                         <item>-vbeln
                                         lf_veanz
                                CHANGING ct_genpos
                                         lf_tabix.
        CLEAR <item>-posnr_gen.
        IF <item>-updkz = 'E'.
          CLEAR <item>.
        ENDIF.
      ENDIF.
    ENDLOOP.

*.. Reduce delivery quantity for deleted HUs
    LOOP AT gt_yvekp ASSIGNING <header>
                   WHERE NOT posnr_gen IS INITIAL
                   AND updkz CA 'DE'.
      CHECK <header>-vpobj = is_object-object.
      CLEAR: ls_genpos, ls_venum.
*     check if item change is possible for current delivery
      IF NOT  <header>-vbeln_gen IS INITIAL.
        READ TABLE lt_dlvstatus INTO ls_dlvstatus
                               WITH KEY vbeln = <header>-vbeln_gen
                               BINARY SEARCH.
        CHECK sy-subrc IS INITIAL.
        CHECK NOT ls_dlvstatus-chgeallowd IS INITIAL.
      ENDIF.
      READ TABLE ct_genpos INTO ls_genpos
                           WITH KEY vhilm = <header>-vhilm
                                    vbeln = <header>-vbeln_gen
                                    posnr = <header>-posnr_gen
                                    BINARY SEARCH.
      lf_tabix = sy-tabix.
      IF sy-subrc IS INITIAL.
*       delivery item line still exists
        ls_genpos-lfimg_new = ls_genpos-lfimg_new - 1.
        CLEAR: <header>-vbeln_gen, <header>-posnr_gen.
        IF <header>-updkz = 'E'.
          CLEAR <header>.
        ENDIF.
        ls_genpos-updkz = 'U'.
        MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
      ELSE.
*       delivery item line doesn't exist anymore
        PERFORM create_genpos_entry
                               USING    <header>-venum
                                        -1
                                        <header>-vbeln_gen
                               CHANGING ct_genpos
                                        lf_tabix.
        CLEAR: <header>-vbeln_gen, <header>-posnr_gen.
        IF <header>-updkz = 'E'.
          CLEAR <header>.
        ENDIF.
      ENDIF.
    ENDLOOP.


*   Im folgenen nur für Transport da zu schlechte Performance für LF
    IF is_object-object = gc_obj_04.
      CLEAR: ls_header-selkz, ls_header-kzunt.
      MODIFY gt_xvekp FROM ls_header TRANSPORTING selkz kzunt
                                     WHERE NOT selkz IS INITIAL OR
                                           NOT kzunt IS INITIAL.
      LOOP AT gt_xvekp ASSIGNING <header_top> WHERE uevel IS INITIAL.
        CLEAR: lf_del, lf_max.
        REFRESH: lt_header, lt_items.
        IF NOT <header_top>-vpobj = gc_obj_12.
*         leave if HU doesn't belong to Transport
          CHECK <header_top>-vpobj = is_object-object.
        ELSE.
          lf_del = charx.
        ENDIF.
        CALL FUNCTION 'HU_ONE_HU_GET'
          EXPORTING
            if_venum     = <header_top>-venum
          IMPORTING
            ef_level_max = lf_max
            et_header    = lt_header
            et_items     = lt_items.

***********************************************************************
*     PROCESSING DELIVERY ITEMS FOR UNASSIGNED HUS                    *
***********************************************************************

        IF NOT lf_del IS INITIAL.     "Gibts im ersten Schr. nicht!
          LOOP AT lt_header ASSIGNING <header>
                            WHERE NOT posnr_gen IS INITIAL.
            CLEAR: ls_genpos, ls_venum.
*           delivery item already exists but should be deleted
            READ TABLE ct_genpos INTO ls_genpos
                               WITH KEY vhilm = <header>-vhilm
                                        vbeln = <header>-vbeln_gen
                                        posnr = <header>-posnr_gen
                                        BINARY SEARCH.
            lf_subrc = sy-subrc.
            lf_tabix = sy-tabix.
            IF lf_subrc IS INITIAL.
*             corresponding delivery item line exists already
              IF ls_genpos-updkz <> 'I'.
                ls_genpos-updkz = 'U'.
              ENDIF.
              ls_genpos-lfimg_new = ls_genpos-lfimg_new - 1.
              MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
            ELSE.
*             create a new delivery item line
*             we enter this case only in case there were already
*             inconsistencies or manually deleted delivery items
              PERFORM create_genpos_entry
                                   USING    <header>-venum
                                            -1
                                            <header>-vbeln_gen
                                   CHANGING ct_genpos
                                            lf_tabix.
            ENDIF.
            <header>-updkz = 'U'.
            CLEAR: <header>-vbeln_gen, <header>-posnr_gen.
            MODIFY gt_xvekp FROM <header>
                             TRANSPORTING liefnr kunnr
                             WHERE venum = <header>-venum.
          ENDLOOP.
          DELETE lt_items WHERE velin NE '2'.
          LOOP AT lt_items ASSIGNING <item>
                           WHERE NOT posnr_gen IS INITIAL.
*           delivery item already exists but should be deleted
            CLEAR: ls_genpos, ls_venum.
            READ TABLE ct_genpos INTO ls_genpos
                            WITH KEY vhilm = <item>-matnr
                                     vbeln = <item>-vbeln
                                     posnr = <item>-posnr_gen
                                     BINARY SEARCH.
            lf_subrc = sy-subrc.
            lf_tabix = sy-tabix.
*           for withdrawl we have to take the quantities at the
*           item creation point of time ...
            CLEAR lf_veanz.
            READ TABLE gt_yvepo ASSIGNING <vepo>
                          WITH KEY venum = <item>-venum
                                   vepos = <item>-vepos
                          BINARY SEARCH.
            CHECK sy-subrc IS INITIAL.
            lf_veanz = <vepo>-veanz.

            IF lf_subrc IS INITIAL.
*             corresponding delivery item line exists already
              IF ls_genpos-updkz <> 'I'.
                ls_genpos-updkz = 'U'.
              ENDIF.
              ls_genpos-lfimg_new
                       = ls_genpos-lfimg_new - lf_veanz.
              MODIFY ct_genpos FROM ls_genpos INDEX lf_tabix.
            ELSE.
*             create a new delivery item line
              lf_veanz = -1 * lf_veanz.
              PERFORM create_genpos_entry_aux
                                   USING    <item>-venum
                                            <item>-vepos
                                            <item>-vbeln
                                            lf_veanz
                                   CHANGING ct_genpos
                                            lf_tabix.
            ENDIF.
            <item>-updkz = 'U'.
            CLEAR <item>-posnr_gen.
          ENDLOOP.
          CONTINUE.
        ENDIF.

***********************************************************************
*     DETERMINE DELIVERY RELATION FOR "NON-EMPTY-HUS"                 *
***********************************************************************

        DELETE lt_items WHERE velin EQ '2'.
        IF sy-subrc IS INITIAL.
          lf_auxpackmat = charx.
        ENDIF.
        SORT lt_header BY histu DESCENDING. "hirarchy bottom-up
        SORT lt_items BY venum vepos.
        LOOP AT lt_header ASSIGNING <header>.
          CLEAR: ls_genpos, ls_venum.
          IF <header>-vpobj NE is_object-object.
            READ TABLE lt_dlvstatus INTO ls_dlvstatus
                                   WITH KEY vbeln = <header>-vpobjkey
                                   BINARY SEARCH.
            CHECK sy-subrc IS INITIAL.
            <header>-kunnr  = ls_dlvstatus-kunnr.
            <header>-liefnr = <header>-vpobjkey.
            <header>-selkz  = charx.
            CONTINUE.
          ELSE.   "Transport-HU (im ersten Schritt)
*           Dynamic fields "kunnr" / "vbeln" are filled to this logic:
*           Prio1: the HU itself contains material belonging to a
*                  delivery for which the HU already has an item
*           Prio2: the HU contains a material for a different delivery
*                  link than vbeln_gen (also for initial vbeln_gen)
*           Prio3: the HU contains no material, but the delivery for
*                  which it has an item is contained in lower level HU
            READ TABLE lt_items TRANSPORTING NO FIELDS
                                WITH KEY venum = <header>-venum
                                BINARY SEARCH.
            CHECK sy-subrc IS INITIAL. "leave if empty lowest level HU
            CLEAR: lf_dlvlinkprio1, lf_dlvlinkprio2, lf_dlvlinkprio3.
            LOOP AT lt_items ASSIGNING <item> FROM sy-tabix.
              CLEAR: ls_genpos.
              IF NOT <item>-venum = <header>-venum. EXIT. ENDIF.
              CASE <item>-velin.
                WHEN '1'.
                  lf_vbeln = <item>-vbeln.
                  READ TABLE lt_dlvstatus INTO ls_dlvstatus
                           WITH KEY vbeln = lf_vbeln
                           BINARY SEARCH.                     .
                  CHECK sy-subrc IS INITIAL.
                  lf_kunnr = ls_dlvstatus-kunnr.
                  IF <header>-selkz  IS INITIAL.
*                   before current loop no delivery link found
                    IF lf_vbeln = <header>-vbeln_gen.
                      lf_dlvlinkprio1 = charx.
                    ELSE.
*                     delivery link according to material item
                      lf_dlvlinkprio2 = charx.
                    ENDIF.
                    <header>-liefnr = lf_vbeln.
                    <header>-kunnr  = lf_kunnr.
                    <header>-selkz  = 'X'.
                  ELSE.
*                   delivery link already found in a former loop
                    IF <header>-kunnr <> lf_kunnr.
                      CLEAR lf_kunnr.
                      CLEAR <header>-kunnr.
                      IF <header>-kzpgn CA ' A'.
                        EXIT.
                      ENDIF.
                    ENDIF.

                    IF lf_dlvlinkprio1 IS INITIAL.
                      IF lf_vbeln = <header>-vbeln_gen.
                        <header>-liefnr = lf_vbeln.
                        <header>-kunnr  = lf_kunnr.
                        <header>-selkz  = 'X'.
                        lf_dlvlinkprio1 = charx.
                      ELSEIF lf_dlvlinkprio2 IS INITIAL.
                        <header>-liefnr = lf_vbeln.
                        <header>-kunnr  = lf_kunnr.
                        <header>-selkz  = 'X'.
                        lf_dlvlinkprio2 = charx.
                      ENDIF.
                    ELSE.
*                     nothing should overwrite a prio1 Delivery Link
                    ENDIF.
                  ENDIF.

                WHEN '2'.                 "wurden vorher rausgelöscht

                WHEN '3'.
                  READ TABLE lt_header ASSIGNING <header2>
                                       WITH KEY venum = <item>-unvel.
                  CHECK sy-subrc IS INITIAL.
                  lf_vbeln = <header2>-liefnr.
                  lf_kunnr = <header2>-kunnr.
                  IF NOT lf_vbeln IS INITIAL.
                    IF <header>-selkz  IS INITIAL.
*                     before current loop no delivery link found
                      IF lf_vbeln = <header>-vbeln_gen.
                        lf_dlvlinkprio3 = charx.
                      ENDIF.
                      <header>-liefnr = lf_vbeln.
                      <header>-kunnr  = lf_kunnr.
                      <header>-selkz  = 'X'.
                    ELSE.
*                     deliv. link already exists from a former loop
                      IF <header>-kunnr <> lf_kunnr.
                        CLEAR lf_kunnr.
                        CLEAR <header>-kunnr.
                        IF <header>-kzpgn CA ' A'.
                          EXIT.
                        ENDIF.
                      ENDIF.

                      IF lf_dlvlinkprio1 IS INITIAL
                             AND lf_dlvlinkprio2 IS INITIAL.
                        IF lf_vbeln = <header>-vbeln_gen.
                          <header>-liefnr = lf_vbeln.
                          <header>-kunnr  = lf_kunnr.
                          <header>-selkz  = 'X'.
                          lf_dlvlinkprio3 = charx.
                        ENDIF.
                      ELSE.
*                       delivery link from pack.mat doesn't overwrite
                      ENDIF.
                    ENDIF.  "IF <header>-selkz  IS INITIAL
                  ENDIF.  "IF NOT lf_vbeln IS INITIAL
              ENDCASE.  "CASE <item>-velin
            ENDLOOP.  "LOOP AT lt_items ASSIGNING <item> FROM sy-tabix

*           update gt_xvekp dynamic fields possible?
            IF NOT <header>-selkz IS INITIAL.
*             delivery where to generate items was determined.
*             check in case of repacking if movement status of the
*             the emitting delivery still allows changes ...
              IF NOT <header>-vbeln_gen IS INITIAL
                   AND <header>-vbeln_gen <> <header>-liefnr.
                READ TABLE lt_dlvstatus INTO ls_dlvstatus
                         WITH KEY vbeln = <header>-vbeln_gen
                         BINARY SEARCH.                     .
                CHECK sy-subrc IS INITIAL.
                IF ls_dlvstatus-chgeallowd IS INITIAL.
*                 no change allowed -> restore dynamic fields
*                 >>>>>>>>>>>>>> insert a message <<<<<<<<<<<<<<<<
*                  lt_ret-type        = .
*                  lt_ret-id          = .
*                  lt_ret-number      = .
*                  lt_ret-message_v1  = .
*                  lt_ret-field       = .
*                  APPEND lt_ret.
                  <header>-liefnr = <header>-vbeln_gen.
                  IF NOT <header>-kunnr IS INITIAL.
                    IF ls_dlvstatus-kunnr <> <header>-kunnr.
*                     <header>-kunnr contains the so-far determined
*                     unique ship-to of the hierarchy for <header>
*                     -> check if it meets also ls_dlvstatus-kunnr
                      CLEAR <header>-kunnr.
                    ENDIF.
                  ENDIF.
                ENDIF. "IF ls_dlvstatus-chgeallowd IS initial.
              ENDIF. "IF NOT <header>-vbeln_gen IS initial.
*             update the dynamic fields in gt_xvekp
              MODIFY gt_xvekp FROM <header>
                               TRANSPORTING liefnr kunnr
                               WHERE venum = <header>-venum.
            ENDIF.  "IF NOT <header>-selkz IS INITIAL.
          ENDIF.  "Transport-HU
        ENDLOOP.  "LOOP AT lt_header ASSIGNING <header>

***********************************************************************
*     DETERMINE DELIVERY RELATION FOR "EMPTY-LOW-LEVEL-HUS"           *
***********************************************************************

*       Now the processing of the upper level HU hirarchy is finished
*       which means that the dynamic fields liefnr and kunnr of the
*       HUs are up-to-date. Now we process the "empty low levels".
*       Note that non-shipment-HUs mustn't be changed!
        LOOP AT lt_header ASSIGNING <header_kzunt>
                          WHERE NOT kzunt IS INITIAL.
*         set 'selkz' for shipment HUs w/o delivery assignment
          CHECK NOT <header_kzunt>-histu = 0.
          lf_nestlevels = <header_kzunt>-histu + 1.
          READ TABLE gt_xvekp WITH KEY venum = <header_kzunt>-venum
                                  ASSIGNING <header_gt>
                                  BINARY SEARCH.
          IF NOT sy-subrc IS INITIAL.
*           this should not happen -> error!!
          ENDIF.
          CLEAR ls_header.
          MODIFY gt_xvekp FROM ls_header TRANSPORTING selkz
                                   WHERE NOT selkz IS INITIAL.
          DO lf_nestlevels TIMES.  "no endless loop on inconsist. data
            IF <header_gt>-vpobj = gc_obj_04.
*             HU belongs to transport ...
              IF NOT <header_gt>-liefnr IS INITIAL.
*               upper level HU with delivery relation found ...
                MODIFY gt_xvekp FROM <header_gt>
                              TRANSPORTING liefnr kunnr
                              WHERE NOT selkz IS INITIAL.
                EXIT.
              ELSE.
                <header_gt>-selkz = charx.
              ENDIF.
            ELSE.
*             HU doesn't belong to a transport -> remains unchanged
            ENDIF.
            IF <header_gt>-histu = 0.
*             reached top HU, but no delivery link determined so far
              EXIT.
            ELSE.
*             Climb up hierarchy for next loop (shift <header2>)
              IF NOT <header_gt>-uevel IS INITIAL.
                READ TABLE gt_xvekp ASSIGNING <header_gt>
                              WITH KEY venum = <header_gt>-uevel.
              ELSE.
                READ TABLE lt_items ASSIGNING <item>
                                 WITH KEY unvel = <header_gt>-venum.
                IF NOT sy-subrc IS INITIAL. EXIT. ENDIF.
                READ TABLE gt_xvekp ASSIGNING <header_gt>
                                    WITH KEY venum = <item>-venum.
              ENDIF.
            ENDIF.
          ENDDO.
        ENDLOOP.  "LOOP AT lt_header ASSIGNING <header_kzunt>
      ENDLOOP.  "LOOP AT gt_xvekp ASSIGNING <header_top>


*     collect all information for delivery item creation in gt_xvekp
*     (lt_header can't be used anymore as it only contains the
*     hierarchy belonging to one TOP-HU of the shipment)
      LOOP AT gt_xvekp ASSIGNING <header>.
        CHECK <header>-vpobj = gc_obj_04.
*       check if item change is possible from emitting delivery
        IF NOT <header>-vbeln_gen IS INITIAL.
          READ TABLE lt_dlvstatus INTO ls_dlvstatus
                                 WITH KEY vbeln = <header>-vbeln_gen
                                 BINARY SEARCH.                     .
          CHECK sy-subrc IS INITIAL.
          CHECK NOT ls_dlvstatus-chgeallowd IS INITIAL.
        ENDIF.
        CLEAR: ls_venum, ls_genpos.

***********************************************************************
*     UPDATE CT_GENPOS - FIRST STEP : AUXILIARY PACKAGING MATERIAL    *
***********************************************************************

*       Update auxiliary packaging material for current <header>
*       (kunnr / liefnr are relyable before processing <header>)
        IF NOT lf_auxpackmat IS INITIAL.
          READ TABLE gt_xvepo TRANSPORTING NO FIELDS
                              WITH KEY venum = <header>-venum
                              BINARY SEARCH.
          IF sy-subrc IS INITIAL.
            LOOP AT gt_xvepo ASSIGNING <item> FROM sy-tabix.
              IF <item>-venum <> <header>-venum.
                EXIT.
              ENDIF.
              CHECK <item>-velin = '2'.
